@startuml use-case-overview
left to right direction

<style>
root {
  BackgroundColor transparent;
  FontSize 18;
  FontName "Times New Roman";
  LineColor #333333;
  LineThickness 1;
}

actor {
  FontSize 18;
  FontName "Times New Roman";
  FontStyle bold;
}

usecase {
  FontSize 16;
  FontName "Times New Roman";
  Padding 5;
  LineThickness 1;
}

package {
  FontSize 16;
  FontName "Times New Roman";
  FontStyle bold;
  Padding 7;
  LineThickness 1;
}

rectangle {
  Padding 10;
  LineThickness 1;
}
</style>

actor "Administrator" as Admin

rectangle "ReSys.Shop" {

  package "Catalog" as Cat {
    usecase (Manage Products) as UC1
    usecase (Manage Variants) as UC2
    usecase (Manage Images & Emb.) as UC3
    usecase (Manage Taxonomies) as UC4
    usecase (Manage Option Types) as UC5
    usecase (Browse & Search) as UC6
    usecase (Visual Search) as UC7
  }

  package "Ordering" as Ord {
    usecase (Manage Orders) as UC8
    usecase (Manage Order Details) as UC9
    usecase (Manage Cart) as UC10
    usecase (Checkout) as UC11
    usecase (Order History) as UC12
  }

  package "Payment" as Pay {
    usecase (Manage Payments) as UC13
    usecase (Manage Pay. Methods) as UC14
    usecase (Payment Processing) as UC15
  }

  package "Inventory" as Inv {
    usecase (Manage Stock) as UC16
    usecase (Manage Stock Loc.) as UC17
  }

  package "Identity" as Idn {
    usecase (Manage Users) as UC18
    usecase (Manage Roles) as UC19
    usecase (Authentication) as UC20
    usecase (Session Management) as UC21
  }

  package "Shipping" as Shp {
    usecase (Manage Shipping) as UC22
  }

  package "Location" as Loc {
    usecase (Manage Ref. Data) as UC23
  }

  package "Profile" as Prf {
    usecase (Profile Management) as UC24
  }

  package "System Services" as Sys {
    usecase (Embedding Operations) as UC25
    usecase (System Maintenance) as UC26
  }
}

actor "Customer" as Customer
actor "System\n(Background)" as SysActor

Admin --> Cat
Admin --> Ord
Admin --> Pay
Admin --> Inv
Admin --> Idn
Admin --> Shp
Admin --> Loc

Customer --> Cat
Customer --> Ord
Customer --> Pay
Customer --> Idn
Customer --> Prf

SysActor --> Sys
@enduml
