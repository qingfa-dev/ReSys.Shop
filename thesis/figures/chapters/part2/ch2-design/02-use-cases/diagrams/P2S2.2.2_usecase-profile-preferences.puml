@startuml usecase-profile-preferences

left to right direction

skinparam shadowing false
skinparam dpi 180

<style>

root {
  FontName "Arial"
  FontSize 18
  FontColor #111111
}

actor {
  FontName "Arial"
  FontSize 18
  FontStyle bold
  FontColor #111111
  BackgroundColor #FFFFFF
  LineColor #222222
  LineThickness 2
}

usecase {
  FontName "Arial"
  FontSize 17
  FontColor #111111
  FontStyle plain
  BackgroundColor #FFFFFF
  LineColor #222222
  LineThickness 2
  Padding 18
}

rectangle {
  FontName "Arial"
  FontSize 22
  FontStyle bold
  FontColor #111111
  BackgroundColor #F7F9FA
  LineColor #263238
  LineThickness 3
  RoundCorner 12
  Padding 30
}

arrow {
  FontName "Arial"
  FontSize 15
  FontColor #111111
  LineColor #333333
  LineThickness 2
}

</style>

title Use Case: UC-STR-PRF\nProfile and Preferences

actor "Customer" as Customer

rectangle "ReSys.Shop\nCustomer Self-Service Subsystem" {

  usecase "Manage Addresses\nUC-STR-PRF-ADDR" as UC_ADDR

  usecase "Manage Wishlists\nUC-STR-PRF-WISH" as UC_WISH

  usecase "Manage Notification Preferences\nUC-STR-PRF-NOTIF" as UC_NOTIF

}

Customer --> UC_ADDR
Customer --> UC_WISH
Customer --> UC_NOTIF

@enduml