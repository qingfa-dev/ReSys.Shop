@startuml usecase-profile-preferences
left to right direction

<style>
  root {
    FontName "Arial"
    FontSize 14
    Shadowing 0
  }
  actor {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
    FontStyle bold
    FontSize 16
  }
  usecase {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
  }
  rectangle {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontStyle bold
  }
  arrow {
    LineColor #000000
    LineThickness 1.5
    FontSize 12
  }
</style>
title UC-STR-PRF: Profile and Preferences

actor "Customer" as Cust

rectangle "Profile and Preferences" {
  usecase "Profile and\nPreferences\n[UC-STR-PRF]" as UC_MAIN
  usecase "Manage Addresses" as UC_ADDR
  usecase "Manage Wishlists" as UC_WISH
  usecase "Manage Notification\nPreferences" as UC_NOTIF

  UC_MAIN ..> UC_ADDR : <<include>>
  UC_MAIN ..> UC_WISH : <<include>>
  UC_MAIN ..> UC_NOTIF : <<include>>
}

Cust --> UC_MAIN

@enduml
