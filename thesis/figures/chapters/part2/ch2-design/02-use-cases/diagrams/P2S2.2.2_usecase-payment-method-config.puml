@startuml usecase-payment-method-config

left to right direction

skinparam shadowing false
skinparam dpi 180

<style>

root {
  FontName "Arial"
  FontSize 18
  FontColor #111111
}

actor {
  FontName "Arial"
  FontSize 18
  FontStyle bold
  FontColor #111111
  BackgroundColor #FFFFFF
  LineColor #222222
  LineThickness 2
}

usecase {
  FontName "Arial"
  FontSize 17
  FontColor #111111
  FontStyle plain
  BackgroundColor #FFFFFF
  LineColor #222222
  LineThickness 2
  Padding 18
}

rectangle {
  FontName "Arial"
  FontSize 22
  FontStyle bold
  FontColor #111111
  BackgroundColor #F7F9FA
  LineColor #263238
  LineThickness 3
  RoundCorner 12
  Padding 30
}

arrow {
  FontName "Arial"
  FontSize 15
  FontColor #111111
  LineColor #333333
  LineThickness 2
}

</style>

title Use Case: UC-ADM-PAY-METHOD\nPayment Method Configuration

actor "Administrator" as Admin

rectangle "ReSys.Shop\nPayment Subsystem" {

  usecase "Manage Payment Methods\nUC-ADM-PAY-METHOD" as UC_MAIN

  usecase "Create Payment Method\nUC-ADM-PAY-METHOD-NEW" as UC_CREATE

  usecase "Configure Method Settings\nUC-ADM-PAY-METHOD-CFG" as UC_CONFIG

  usecase "Toggle Method Status\nUC-ADM-PAY-METHOD-STS" as UC_TOGGLE

  usecase "Configure Gateway Credentials\nUC-ADM-PAY-METHOD-API" as UC_API

}

Admin --> UC_MAIN
Admin --> UC_CREATE
Admin --> UC_CONFIG
Admin --> UC_TOGGLE

UC_CONFIG ..> UC_API : <<include>>

@enduml