@startuml usecase-payment-method-config
left to right direction

<style>
  root {
    FontName "Arial"
    FontSize 14
    Shadowing 0
  }
  actor {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
    FontStyle bold
    FontSize 16
  }
  usecase {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
  }
  rectangle {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontStyle bold
  }
  arrow {
    LineColor #000000
    LineThickness 1.5
    FontSize 12
  }
</style>
title UC-ADM-PAY-METHOD: Payment Method Configuration

actor "Administrator" as Admin

rectangle "Payment Method Configuration" {
  usecase "Manage Payment Methods\n[UC-ADM-PAY-METHOD]" as UC_MAIN
}

Admin --> UC_MAIN

@enduml
