@startuml usecase-product-management
left to right direction

<style>
  root {
    FontName "Arial"
    FontSize 14
    Shadowing 0
  }
  actor {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
    FontStyle bold
    FontSize 16
  }
  usecase {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
  }
  rectangle {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontStyle bold
  }
  arrow {
    LineColor #000000
    LineThickness 1.5
    FontSize 12
  }
</style>
title UC-ADM-PROD: Product Management

actor "Administrator" as Admin

rectangle "Product Management" {
  usecase "Manage Products\n[UC-ADM-PROD]" as UC_MAIN
  usecase "Create Product" as UC_SUB_1
  usecase "Update Product" as UC_SUB_2
  usecase "Archive Product" as UC_SUB_3

  UC_MAIN ..> UC_SUB_1 : <<include>>
  UC_MAIN ..> UC_SUB_2 : <<include>>
  UC_MAIN ..> UC_SUB_3 : <<include>>
}

Admin --> UC_MAIN

@enduml
