@startuml usecase-product-management

left to right direction

skinparam shadowing false
skinparam dpi 180

<style>

root {
  FontName "Arial"
  FontSize 18
  FontColor #111111
}

actor {
  FontName "Arial"
  FontSize 18
  FontStyle bold
  FontColor #111111
  BackgroundColor #FFFFFF
  LineColor #222222
  LineThickness 2
}

usecase {
  FontName "Arial"
  FontSize 17
  FontColor #111111
  FontStyle plain
  BackgroundColor #FFFFFF
  LineColor #222222
  LineThickness 2
  Padding 18
}

rectangle {
  FontName "Arial"
  FontSize 22
  FontStyle bold
  FontColor #111111
  BackgroundColor #F7F9FA
  LineColor #263238
  LineThickness 3
  RoundCorner 12
  Padding 30
}

arrow {
  FontName "Arial"
  FontSize 15
  FontColor #111111
  LineColor #333333
  LineThickness 2
}

</style>

title Use Case: UC-ADM-PROD\nProduct Management

actor "Administrator" as Admin

rectangle "ReSys.Shop\nAdministration Portal" {

  usecase "Create Product\nUC-ADM-PROD-CREATE" as UC_CREATE

  usecase "Update Product\nUC-ADM-PROD-UPDATE" as UC_UPDATE

  usecase "Archive Product\nUC-ADM-PROD-ARCHIVE" as UC_ARCHIVE

}

Admin --> UC_CREATE
Admin --> UC_UPDATE
Admin --> UC_ARCHIVE

@enduml