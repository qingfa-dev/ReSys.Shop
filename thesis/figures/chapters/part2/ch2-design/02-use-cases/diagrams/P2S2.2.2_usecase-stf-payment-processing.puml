@startuml usecase-stf-payment-processing
left to right direction

<style>
  root {
    FontName "Arial"
    FontSize 14
    Shadowing 0
  }
  actor {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
    FontStyle bold
    FontSize 16
  }
  usecase {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
  }
  rectangle {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontStyle bold
  }
  arrow {
    LineColor #000000
    LineThickness 1.5
    FontSize 12
  }
</style>
title UC-STR-PAY: Payment Processing

actor "Customer" as Cust
actor "Payment Gateway" as GW

rectangle "Payment Processing" {
  usecase "Payment Processing\n[UC-STR-PAY]" as UC_MAIN
  usecase "Create Payment Intent" as UC_INTENT
  usecase "Confirm Payment" as UC_CONFIRM

  UC_MAIN ..> UC_INTENT : <<include>>
  UC_MAIN ..> UC_CONFIRM : <<include>>
}

Cust --> UC_MAIN
GW --> UC_CONFIRM

@enduml
