@startuml usecase-variant-pricing
left to right direction

<style>
  root {
    FontName "Arial"
    FontSize 14
    Shadowing 0
  }
  actor {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
    FontStyle bold
    FontSize 14
  }
  usecase {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
    FontSize 12
  }
  rectangle {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 2
    FontStyle bold
    FontSize 16
  }
  arrow {
    LineColor #000000
    LineThickness 1.5
    FontSize 11
  }
</style>


' === ACTORS ===
actor "Administrator" as Admin

' === SYSTEM BOUNDARY ===
rectangle {

  ' (UC-ADM-VAR)
  usecase "Manage Product Variants" as UC_MAIN
  ' (UC-ADM-VAR-ADD)
  usecase "Add Product Variant" as UC_ADD
  ' (UC-ADM-VAR-OPT)
  usecase "Configure Option Values" as UC_OPT
  ' (UC-ADM-VAR-PRC)
  usecase "Configure Base Pricing" as UC_PRC
  ' (UC-ADM-VAR-DISC)
  usecase "Configure Promotional & Regional Rules" as UC_RULES

}

' === ACTOR INTERACTION ===
Admin --> UC_MAIN

' === GENERALIZATION RELATIONSHIPS ===
' Child use cases specialize the master management boundary
UC_MAIN <|-- UC_ADD
UC_MAIN <|-- UC_OPT
UC_MAIN <|-- UC_PRC

' === EXTENSION RELATIONSHIPS ===
' Price adjustments/promotional rules optionally extend base pricing
UC_RULES ..> UC_PRC : <<extend>>

@enduml