@startuml usecase-variant-pricing
left to right direction

<style>
  root {
    FontName "Arial"
    FontSize 14
    Shadowing 0
  }
  actor {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
    FontStyle bold
    FontSize 16
  }
  usecase {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
  }
  rectangle {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontStyle bold
  }
  arrow {
    LineColor #000000
    LineThickness 1.5
    FontSize 12
  }
</style>
title UC-ADM-VAR: Variant and Pricing

actor "Administrator" as Admin

rectangle "Variant and Pricing" {
  usecase "Manage Variants\n[UC-ADM-VAR]" as UC_MAIN
  usecase "Add Variant" as UC_SUB_1
  usecase "Configure Options" as UC_SUB_2
  usecase "Configure Pricing" as UC_SUB_3

  UC_MAIN ..> UC_SUB_1 : <<include>>
  UC_MAIN ..> UC_SUB_2 : <<include>>
  UC_MAIN ..> UC_SUB_3 : <<include>>
}

Admin --> UC_MAIN

@enduml
