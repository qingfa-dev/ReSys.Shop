@startuml usecase-background-maintenance

left to right direction

skinparam shadowing false
skinparam dpi 180

<style>

root {
  FontName "Arial"
  FontSize 18
  FontColor #111111
}

actor {
  FontName "Arial"
  FontSize 18
  FontStyle bold
  FontColor #111111
  BackgroundColor #FFFFFF
  LineColor #222222
  LineThickness 2
}

usecase {
  FontName "Arial"
  FontSize 17
  FontColor #111111
  FontStyle plain
  BackgroundColor #FFFFFF
  LineColor #222222
  LineThickness 2
  Padding 18
}

rectangle {
  FontName "Arial"
  FontSize 22
  FontStyle bold
  FontColor #111111
  BackgroundColor #F7F9FA
  LineColor #263238
  LineThickness 3
  RoundCorner 12
  Padding 30
}

arrow {
  FontName "Arial"
  FontSize 15
  FontColor #111111
  LineColor #333333
  LineThickness 2
}

</style>


actor "System Scheduler" as Scheduler <<system>>
actor "ML Service" as ML <<system>>
actor "Payment Gateway" as Gateway <<system>>

rectangle {

  ' UC-SYS-MNT-HEALTH
  usecase "Monitor Service Health" as UC_HEALTH

  ' UC-SYS-MNT-CART
  usecase "Expire Abandoned Carts" as UC_CARTS

  ' UC-SYS-MNT-RES
  usecase "Release Expired Reservations" as UC_RES

  ' UC-SYS-MNT-WEB
  usecase "Process Payment Webhooks" as UC_WEB

  ' UC-SYS-MNT-INDEX
  usecase "Maintain Search Index" as UC_INDEX

}

Scheduler --> UC_HEALTH
Scheduler --> UC_CARTS
Scheduler --> UC_RES
Scheduler --> UC_WEB
Scheduler --> UC_INDEX

UC_INDEX --> ML : <<communicates>>
Gateway --> UC_WEB : <<sends webhook>>

@enduml