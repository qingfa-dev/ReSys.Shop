@startuml usecase-taxonomy-classification
left to right direction

<style>
  root {
    FontName "Arial"
    FontSize 14
    Shadowing 0
  }
  actor {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
    FontStyle bold
    FontSize 16
  }
  usecase {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
  }
  rectangle {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontStyle bold
  }
  arrow {
    LineColor #000000
    LineThickness 1.5
    FontSize 12
  }
</style>
title UC-ADM-TAX: Taxonomy and Classification

actor "Administrator" as Admin

rectangle "Taxonomy and Classification" {
  usecase "Manage Taxonomies\nand Classification\n[UC-ADM-TAX]" as UC_MAIN
  usecase "Manage Taxonomies" as UC_SUB_1
  usecase "Classify Products" as UC_SUB_2

  UC_MAIN ..> UC_SUB_1 : <<include>>
  UC_MAIN ..> UC_SUB_2 : <<include>>
}

Admin --> UC_MAIN

@enduml
