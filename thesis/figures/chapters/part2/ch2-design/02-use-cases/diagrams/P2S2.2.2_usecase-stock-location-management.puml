@startuml usecase-stock-location-management
left to right direction

<style>
  root {
    fontName "Arial"
    fontSize 14
    shadowing false
  }
  actor {
    backgroundColor #FFFFFF
    borderColor #000000
    borderThickness 1.5
    fontColor #000000
    fontStyle bold
    fontSize 16
  }
  usecase {
    backgroundColor #FFFFFF
    borderColor #000000
    borderThickness 1.5
    fontColor #000000
  }
  rectangle {
    backgroundColor #FFFFFF
    borderColor #000000
    borderThickness 1.5
    fontStyle bold
  }
  arrow {
    lineColor #000000
    lineThickness 1.5
    fontSize 12
  }
</style>
title UC-ADM-LOC: Stock Location Management

actor "Administrator" as Admin

rectangle "Stock Location Management" {
  usecase "Manage Stock Locations\n[UC-ADM-LOC]" as UC_MAIN
}

Admin --> UC_MAIN

@enduml
