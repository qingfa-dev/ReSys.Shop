@startuml usecase-session-management

left to right direction

skinparam shadowing false
skinparam dpi 180

<style>

root {
  FontName "Arial"
  FontSize 18
  FontColor #111111
}

actor {
  FontName "Arial"
  FontSize 18
  FontStyle bold
  FontColor #111111
  BackgroundColor #FFFFFF
  LineColor #222222
  LineThickness 2
}

usecase {
  FontName "Arial"
  FontSize 17
  FontColor #111111
  FontStyle plain
  BackgroundColor #FFFFFF
  LineColor #222222
  LineThickness 2
  Padding 18
}

rectangle {
  FontName "Arial"
  FontSize 22
  FontStyle bold
  FontColor #111111
  BackgroundColor #F7F9FA
  LineColor #263238
  LineThickness 3
  RoundCorner 12
  Padding 30
}

arrow {
  FontName "Arial"
  FontSize 15
  FontColor #111111
  LineColor #333333
  LineThickness 2
}

</style>

title Use Case: UC-STR-SES\nSession Management

actor "Customer" as Customer

rectangle "ReSys.Shop\nCustomer Self-Service Subsystem" {

  usecase "Refresh Session\nUC-STR-SES-REFRESH" as UC_REFRESH

  usecase "Logout\nUC-STR-SES-LOGOUT" as UC_LOGOUT

}

Customer --> UC_REFRESH
Customer --> UC_LOGOUT

@enduml