@startuml usecase-session-management
left to right direction

<style>
  root {
    FontName "Arial"
    FontSize 14
    Shadowing 0
  }
  actor {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
    FontStyle bold
    FontSize 16
  }
  usecase {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
  }
  rectangle {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontStyle bold
  }
  arrow {
    LineColor #000000
    LineThickness 1.5
    FontSize 12
  }
</style>
title UC-STR-SES: Session Management

actor "Customer" as Cust

rectangle "Session Management" {
  usecase "Session Management\n[UC-STR-SES]" as UC_MAIN
  usecase "Refresh Session" as UC_REFRESH
  usecase "Logout" as UC_LOGOUT

  UC_MAIN ..> UC_REFRESH : <<include>>
  UC_MAIN ..> UC_LOGOUT : <<include>>
}

Cust --> UC_MAIN

@enduml
