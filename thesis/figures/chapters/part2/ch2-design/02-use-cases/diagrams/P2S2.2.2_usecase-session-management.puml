@startuml usecase-session-management
left to right direction

<style>
  root {
    fontName "Arial"
    fontSize 14
    shadowing false
  }
  actor {
    backgroundColor #FFFFFF
    borderColor #000000
    borderThickness 1.5
    fontColor #000000
    fontStyle bold
    fontSize 16
  }
  usecase {
    backgroundColor #FFFFFF
    borderColor #000000
    borderThickness 1.5
    fontColor #000000
  }
  rectangle {
    backgroundColor #FFFFFF
    borderColor #000000
    borderThickness 1.5
    fontStyle bold
  }
  arrow {
    lineColor #000000
    lineThickness 1.5
    fontSize 12
  }
</style>
title UC-STR-SES: Session Management

actor "Customer" as Cust

rectangle "Session Management" {
  usecase "Session Management\n[UC-STR-SES]" as UC_MAIN
  usecase "Refresh Session" as UC_REFRESH
  usecase "Logout" as UC_LOGOUT

  UC_MAIN ..> UC_REFRESH : <<include>>
  UC_MAIN ..> UC_LOGOUT : <<include>>
}

Cust --> UC_MAIN

@enduml
