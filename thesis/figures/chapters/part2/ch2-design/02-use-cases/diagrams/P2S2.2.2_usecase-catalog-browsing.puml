@startuml usecase-catalog-browsing
left to right direction

<style>
  root {
    FontName "Arial"
    FontSize 14
    Shadowing 0
  }
  actor {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
    FontStyle bold
    FontSize 16
  }
  usecase {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
  }
  rectangle {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontStyle bold
  }
  arrow {
    LineColor #000000
    LineThickness 1.5
    FontSize 12
  }
</style>
title UC-STR-BRW: Catalog Browsing

actor "Customer" as Cust

rectangle "Catalog Browsing" {
  usecase "Catalog Browsing\n[UC-STR-BRW]" as UC_MAIN
  usecase "Browse Catalog" as UC_BROWSE
  usecase "View Product Detail" as UC_DETAIL
  usecase "Keyword Search" as UC_SEARCH

  UC_MAIN ..> UC_BROWSE : <<include>>
  UC_MAIN ..> UC_DETAIL : <<include>>
  UC_MAIN ..> UC_SEARCH : <<include>>
}

Cust --> UC_MAIN

@enduml
