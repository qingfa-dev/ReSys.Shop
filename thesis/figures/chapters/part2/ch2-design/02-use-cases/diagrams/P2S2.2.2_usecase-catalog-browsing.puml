@startuml usecase-catalog-browsing

left to right direction

skinparam shadowing false
skinparam dpi 180

<style>

root {
  FontName "Arial"
  FontSize 18
  FontColor #111111
}

actor {
  FontName "Arial"
  FontSize 18
  FontStyle bold
  FontColor #111111
  BackgroundColor #FFFFFF
  LineColor #222222
  LineThickness 2
}

usecase {
  FontName "Arial"
  FontSize 17
  FontColor #111111
  FontStyle plain
  BackgroundColor #FFFFFF
  LineColor #222222
  LineThickness 2
  Padding 18
}

rectangle {
  FontName "Arial"
  FontSize 22
  FontStyle bold
  FontColor #111111
  BackgroundColor #F7F9FA
  LineColor #263238
  LineThickness 3
  RoundCorner 12
  Padding 30
}

arrow {
  FontName "Arial"
  FontSize 15
  FontColor #111111
  LineColor #333333
  LineThickness 2
}

</style>


actor "Customer" as Customer

rectangle {

  ' UC-STR-BRW-BROWSE
  usecase "Browse Catalog" as UC_BROWSE

  ' UC-STR-BRW-DETAIL
  usecase "View Product Detail" as UC_DETAIL

  ' UC-STR-BRW-SEARCH
  usecase "Keyword Search" as UC_SEARCH

}

Customer --> UC_BROWSE
Customer --> UC_DETAIL
Customer --> UC_SEARCH

@enduml