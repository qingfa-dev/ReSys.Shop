@startuml usecase-cart-management
left to right direction

<style>
  root {
    FontName "Arial"
    FontSize 14
    Shadowing 0
  }
  actor {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
    FontStyle bold
    FontSize 16
  }
  usecase {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
  }
  rectangle {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontStyle bold
  }
  arrow {
    LineColor #000000
    LineThickness 1.5
    FontSize 12
  }
</style>
title UC-STR-CRT: Cart Management

actor "Customer" as Cust

rectangle "Cart Management" {
  usecase "Cart Management\n[UC-STR-CRT]" as UC_MAIN
  usecase "Manage Cart Items" as UC_ITEMS
  usecase "Associate Cart with Account" as UC_ASSOCIATE

  UC_MAIN ..> UC_ITEMS : <<include>>
  UC_MAIN ..> UC_ASSOCIATE : <<include>>
}

Cust --> UC_MAIN

@enduml
