@startuml usecase-cart-management
left to right direction

<style>
  root {
    fontName "Arial"
    fontSize 14
    shadowing false
  }
  actor {
    backgroundColor #FFFFFF
    borderColor #000000
    borderThickness 1.5
    fontColor #000000
    fontStyle bold
    fontSize 16
  }
  usecase {
    backgroundColor #FFFFFF
    borderColor #000000
    borderThickness 1.5
    fontColor #000000
  }
  rectangle {
    backgroundColor #FFFFFF
    borderColor #000000
    borderThickness 1.5
    fontStyle bold
  }
  arrow {
    lineColor #000000
    lineThickness 1.5
    fontSize 12
  }
</style>
title UC-STR-CRT: Cart Management

actor "Customer" as Cust

rectangle "Cart Management" {
  usecase "Cart Management\n[UC-STR-CRT]" as UC_MAIN
  usecase "Manage Cart Items" as UC_ITEMS
  usecase "Associate Cart with Account" as UC_ASSOCIATE

  UC_MAIN ..> UC_ITEMS : <<include>>
  UC_MAIN ..> UC_ASSOCIATE : <<include>>
}

Cust --> UC_MAIN

@enduml
