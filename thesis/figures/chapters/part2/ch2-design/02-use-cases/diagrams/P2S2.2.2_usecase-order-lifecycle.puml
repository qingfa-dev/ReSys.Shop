@startuml usecase-order-lifecycle

left to right direction

skinparam shadowing false
skinparam dpi 180

<style>

root {
  FontName "Arial"
  FontSize 18
  FontColor #111111
}

actor {
  FontName "Arial"
  FontSize 18
  FontStyle bold
  FontColor #111111
  BackgroundColor #FFFFFF
  LineColor #222222
  LineThickness 2
}

usecase {
  FontName "Arial"
  FontSize 17
  FontColor #111111
  FontStyle plain
  BackgroundColor #FFFFFF
  LineColor #222222
  LineThickness 2
  Padding 18
}

rectangle {
  FontName "Arial"
  FontSize 22
  FontStyle bold
  FontColor #111111
  BackgroundColor #F7F9FA
  LineColor #263238
  LineThickness 3
  RoundCorner 12
  Padding 30
}

arrow {
  FontName "Arial"
  FontSize 15
  FontColor #111111
  LineColor #333333
  LineThickness 2
}

</style>


actor "Administrator" as Admin
actor "Payment Gateway" as Gateway <<system>>

rectangle {

  ' UC-ADM-ORD
  usecase "Manage Orders" as UC_MAIN

  usecase "View Orders" as UC_VIEW
  usecase "Update Order" as UC_UPDATE
  usecase "Approve Order" as UC_APPROVE
  usecase "Complete Order" as UC_COMPLETE
  usecase "Cancel Order" as UC_CANCEL
  usecase "Resume Order" as UC_RESUME

  ' UC-ADM-ORD-ITEMS
  usecase "Manage Order Items" as UC_ITEMS

}

Admin --> UC_MAIN
Admin --> UC_ITEMS

UC_MAIN ..> UC_VIEW : <<include>>
UC_MAIN ..> UC_UPDATE : <<include>>
UC_MAIN ..> UC_APPROVE : <<include>>
UC_MAIN ..> UC_COMPLETE : <<include>>
UC_MAIN ..> UC_CANCEL : <<include>>
UC_MAIN ..> UC_RESUME : <<include>>

UC_COMPLETE --> Gateway : <<communicates>>

@enduml