@startuml usecase-stock-item-management

left to right direction

skinparam shadowing false
skinparam dpi 180

<style>

root {
  FontName "Arial"
  FontSize 18
  FontColor #111111
}

actor {
  FontName "Arial"
  FontSize 18
  FontStyle bold
  FontColor #111111
  BackgroundColor #FFFFFF
  LineColor #222222
  LineThickness 2
}

usecase {
  FontName "Arial"
  FontSize 17
  FontColor #111111
  FontStyle plain
  BackgroundColor #FFFFFF
  LineColor #222222
  LineThickness 2
  Padding 18
}

rectangle {
  FontName "Arial"
  FontSize 22
  FontStyle bold
  FontColor #111111
  BackgroundColor #F7F9FA
  LineColor #263238
  LineThickness 3
  RoundCorner 12
  Padding 30
}

arrow {
  FontName "Arial"
  FontSize 15
  FontColor #111111
  LineColor #333333
  LineThickness 2
}

</style>

title Use Case: UC-ADM-STK\nStock Item Management

actor "Administrator" as Admin

rectangle "ReSys.Shop\nInventory & Logistics Subsystem" {

  usecase "Manage Stock Items\nUC-ADM-STK" as UC_MAIN

  usecase "Restock Inventory\nUC-ADM-STK-RESTOCK" as UC_RESTOCK

  usecase "Transfer Stock\nUC-ADM-STK-TRANSFER" as UC_TRANSFER

  usecase "Review Stock Movements\nUC-ADM-STK-MOVEMENTS" as UC_MOVEMENTS

  usecase "Monitor Low Stock\nUC-ADM-STK-LOWSTOCK" as UC_LOWSTOCK

}

Admin --> UC_MAIN
Admin --> UC_RESTOCK
Admin --> UC_TRANSFER
Admin --> UC_MOVEMENTS
Admin --> UC_LOWSTOCK

@enduml