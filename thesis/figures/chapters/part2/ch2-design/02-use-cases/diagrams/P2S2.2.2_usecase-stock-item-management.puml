@startuml usecase-stock-item-management

left to right direction

skinparam shadowing false
skinparam dpi 180

<style>

root {
  FontName "Arial"
  FontSize 18
  FontColor #111111
}

actor {
  FontName "Arial"
  FontSize 18
  FontStyle bold
  FontColor #111111
  BackgroundColor #FFFFFF
  LineColor #222222
  LineThickness 2
}

usecase {
  FontName "Arial"
  FontSize 17
  FontColor #111111
  FontStyle plain
  BackgroundColor #FFFFFF
  LineColor #222222
  LineThickness 2
  Padding 18
}

rectangle {
  FontName "Arial"
  FontSize 22
  FontStyle bold
  FontColor #111111
  BackgroundColor #F7F9FA
  LineColor #263238
  LineThickness 3
  RoundCorner 12
  Padding 30
}

arrow {
  FontName "Arial"
  FontSize 15
  FontColor #111111
  LineColor #333333
  LineThickness 2
}

</style>


actor "Administrator" as Admin

rectangle {

  ' UC-ADM-STK
  usecase "Manage Stock Items" as UC_MAIN

  ' UC-ADM-STK-RESTOCK
  usecase "Restock Inventory" as UC_RESTOCK

  ' UC-ADM-STK-TRANSFER
  usecase "Transfer Stock" as UC_TRANSFER

  ' UC-ADM-STK-MOVEMENTS
  usecase "Review Stock Movements" as UC_MOVEMENTS

  ' UC-ADM-STK-LOWSTOCK
  usecase "Monitor Low Stock" as UC_LOWSTOCK

}

Admin --> UC_MAIN
Admin --> UC_RESTOCK
Admin --> UC_TRANSFER
Admin --> UC_MOVEMENTS
Admin --> UC_LOWSTOCK

@enduml