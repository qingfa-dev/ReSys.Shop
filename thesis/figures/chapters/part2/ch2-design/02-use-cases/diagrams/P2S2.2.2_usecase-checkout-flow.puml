@startuml usecase-checkout-flow
left to right direction

<style>
  root {
    fontName "Arial"
    fontSize 14
    shadowing false
  }
  actor {
    backgroundColor #FFFFFF
    borderColor #000000
    borderThickness 1.5
    fontColor #000000
    fontStyle bold
    fontSize 16
  }
  usecase {
    backgroundColor #FFFFFF
    borderColor #000000
    borderThickness 1.5
    fontColor #000000
  }
  rectangle {
    backgroundColor #FFFFFF
    borderColor #000000
    borderThickness 1.5
    fontStyle bold
  }
  arrow {
    lineColor #000000
    lineThickness 1.5
    fontSize 12
  }
</style>
title UC-STR-CHK: Checkout Flow

actor "Customer" as Cust
actor "Payment Gateway" as GW

rectangle "Checkout Flow" {
  usecase "Checkout Flow\n[UC-STR-CHK]" as UC_MAIN
  usecase "Select Shipping Address" as UC_ADDRESS
  usecase "Select Shipping Method" as UC_METHOD
  usecase "Complete Checkout" as UC_COMPLETE

  UC_MAIN ..> UC_ADDRESS : <<include>>
  UC_MAIN ..> UC_METHOD : <<include>>
  UC_MAIN ..> UC_COMPLETE : <<include>>
}

Cust --> UC_MAIN
GW --> UC_COMPLETE

@enduml
