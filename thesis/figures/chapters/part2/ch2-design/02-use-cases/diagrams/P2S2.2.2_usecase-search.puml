@startuml usecase-search

left to right direction

skinparam shadowing false
skinparam dpi 180

<style>

root {
  FontName "Arial"
  FontSize 18
  FontColor #111111
}

actor {
  FontName "Arial"
  FontSize 18
  FontStyle bold
  FontColor #111111
  BackgroundColor #FFFFFF
  LineColor #222222
  LineThickness 2
}

usecase {
  FontName "Arial"
  FontSize 17
  FontColor #111111
  FontStyle plain
  BackgroundColor #FFFFFF
  LineColor #222222
  LineThickness 2
  Padding 18
}

rectangle {
  FontName "Arial"
  FontSize 22
  FontStyle bold
  FontColor #111111
  BackgroundColor #F7F9FA
  LineColor #263238
  LineThickness 3
  RoundCorner 12
  Padding 30
}

arrow {
  FontName "Arial"
  FontSize 15
  FontColor #111111
  LineColor #333333
  LineThickness 2
}

</style>

title Use Case: UC-STR-SRC\nProduct Search

actor "Customer" as Customer
actor "ML Service" as ML <<system>>

rectangle "ReSys.Shop\nProduct Discovery Subsystem" {

  usecase "Search Products\nUC-STR-SRC" as UC_SEARCH

  usecase "Search by Image (CBIR)\nUC-STR-SRC-CBIR" as UC_CBIR

  usecase "View Similar Products\nUC-STR-SRC-SIMILAR" as UC_SIMILAR

}

Customer --> UC_SEARCH
Customer --> UC_CBIR
Customer --> UC_SIMILAR

UC_CBIR --> ML : <<communicates>>
UC_SIMILAR --> ML : <<communicates>>

@enduml