@startuml usecase-search
left to right direction

<style>
  root {
    FontName "Arial"
    FontSize 14
    Shadowing 0
  }
  actor {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
    FontStyle bold
    FontSize 16
  }
  usecase {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
  }
  rectangle {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontStyle bold
  }
  arrow {
    LineColor #000000
    LineThickness 1.5
    FontSize 12
  }
</style>
title UC-STR-SRC: Search

actor "Customer" as Cust
actor "ML Service" as ML

rectangle "Search" {
  usecase "Search\n[UC-STR-SRC]" as UC_MAIN
  usecase "Search by Image (CBIR)" as UC_CBIR
  usecase "View Similar Products" as UC_SIMILAR

  UC_MAIN ..> UC_CBIR : <<include>>
  UC_MAIN ..> UC_SIMILAR : <<include>>
}

Cust --> UC_MAIN
ML --> UC_CBIR

@enduml
