@startuml usecase-image-embedding
left to right direction

<style>
  root {
    FontName "Arial"
    FontSize 14
    Shadowing 0
  }
  actor {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
    FontStyle bold
    FontSize 16
  }
  usecase {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
  }
  rectangle {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontStyle bold
  }
  arrow {
    LineColor #000000
    LineThickness 1.5
    FontSize 12
  }
</style>
title UC-ADM-IMG: Image and Embedding Management

actor "Administrator" as Admin
actor "ML Service" as ML

rectangle "Image and Embedding Management" {
  usecase "Manage Images\nand Embeddings\n[UC-ADM-IMG]" as UC_MAIN
  usecase "Upload Images" as UC_SUB_1
  usecase "Regenerate Embeddings" as UC_SUB_2

  UC_MAIN ..> UC_SUB_1 : <<include>>
  UC_MAIN ..> UC_SUB_2 : <<include>>
}

Admin --> UC_MAIN
ML --> UC_SUB_2

@enduml
