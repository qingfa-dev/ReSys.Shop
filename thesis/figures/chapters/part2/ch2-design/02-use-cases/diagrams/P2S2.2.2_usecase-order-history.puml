@startuml usecase-order-history
left to right direction

<style>
  root {
    FontName "Arial"
    FontSize 14
    Shadowing 0
  }
  actor {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
    FontStyle bold
    FontSize 16
  }
  usecase {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
  }
  rectangle {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontStyle bold
  }
  arrow {
    LineColor #000000
    LineThickness 1.5
    FontSize 12
  }
</style>
title UC-STR-OHI: Order History

actor "Customer" as Cust
actor "Payment Gateway" as GW

rectangle "Order History" {
  usecase "Order History\n[UC-STR-OHI]" as UC_MAIN
  usecase "View Order History" as UC_VIEW
  usecase "Cancel Order" as UC_CANCEL

  UC_MAIN ..> UC_VIEW : <<include>>
  UC_MAIN ..> UC_CANCEL : <<include>>
}

Cust --> UC_MAIN
GW --> UC_CANCEL

@enduml
