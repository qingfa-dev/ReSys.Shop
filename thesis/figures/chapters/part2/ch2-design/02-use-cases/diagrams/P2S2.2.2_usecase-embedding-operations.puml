@startuml usecase-embedding-operations
left to right direction

<style>
  root {
    FontName "Arial"
    FontSize 14
    Shadowing 0
  }
  actor {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
    FontStyle bold
    FontSize 16
  }
  usecase {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
  }
  rectangle {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontStyle bold
  }
  arrow {
    LineColor #000000
    LineThickness 1.5
    FontSize 12
  }
</style>
title UC-SYS-EMB: Embedding Operations

actor "System (Background)" as Sys
actor "ML Service" as ML

rectangle "Embedding Operations" {
  usecase "Embedding Operations\n[UC-SYS-EMB]" as UC_MAIN
  usecase "Generate Image\nEmbeddings" as UC_GEN
  usecase "Regenerate All Embeddings" as UC_REG

  UC_MAIN ..> UC_GEN : <<include>>
  UC_MAIN ..> UC_REG : <<include>>
}

Sys --> UC_MAIN
ML --> UC_GEN

@enduml
