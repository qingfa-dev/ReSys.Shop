@startuml usecase-embedding-operations

left to right direction

skinparam shadowing false
skinparam dpi 180

<style>

root {
  FontName "Arial"
  FontSize 18
  FontColor #111111
}

actor {
  FontName "Arial"
  FontSize 18
  FontStyle bold
  FontColor #111111
  BackgroundColor #FFFFFF
  LineColor #222222
  LineThickness 2
}

usecase {
  FontName "Arial"
  FontSize 17
  FontColor #111111
  FontStyle plain
  BackgroundColor #FFFFFF
  LineColor #222222
  LineThickness 2
  Padding 18
}

rectangle {
  FontName "Arial"
  FontSize 22
  FontStyle bold
  FontColor #111111
  BackgroundColor #F7F9FA
  LineColor #263238
  LineThickness 3
  RoundCorner 12
  Padding 25
}

arrow {
  FontName "Arial"
  FontSize 15
  FontColor #111111
  LineColor #333333
  LineThickness 2
}

</style>


' ============================================================
' EXTERNAL ACTORS / SYSTEMS
' ============================================================

actor "Job Scheduler" as Scheduler <<system>>

actor "External ML\nInference Service" as MLService <<system>>


' ============================================================
' SYSTEM OF INTEREST
' ============================================================

rectangle {

  ' UC-SYS-EMB

  usecase "Process Vector Embeddings" as UC_MAIN

  ' UC-SYS-EMB-GEN

  usecase "Generate Single Image\nEmbedding" as UC_GEN

  ' UC-SYS-EMB-REG

  usecase "Rebuild Catalog\nVector Index" as UC_REG

}


' ============================================================
' ACTOR ASSOCIATIONS
' ============================================================

Scheduler --> UC_MAIN

UC_GEN --> MLService : <<communicates>>

UC_REG --> MLService : <<communicates>>


' ============================================================
' USE CASE RELATIONSHIPS
' ============================================================

UC_MAIN ..> UC_GEN : <<include>>
UC_MAIN ..> UC_REG : <<include>>

@enduml