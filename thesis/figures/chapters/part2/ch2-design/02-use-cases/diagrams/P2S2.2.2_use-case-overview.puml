@startuml use-case-overview
left to right direction

<style>
  root {
    FontName "Times New Roman"
    FontSize 20
    Shadowing 0
  }
  actor {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
    FontStyle bold
    FontSize 26
  }
  usecase {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontColor #000000
    FontSize 20
  }
  package {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 1.5
    FontStyle bold
    FontSize 24
  }
  rectangle {
    BackGroundColor #FFFFFF
    LineColor #000000
    LineThickness 2
    FontStyle bold
    FontSize 26
  }
  arrow {
    LineColor #000000
    LineThickness 1.5
    FontSize 14
  }
</style>

actor "Administrator" as Admin
actor "Customer" as Customer
actor "System\n(Background)" as SysActor

rectangle {

  package "Catalog" {
    ' [UC-ADM-PROD]
    usecase "Manage Products" as UC_ADM_PROD
    ' [UC-ADM-VAR]
    usecase "Manage Variants" as UC_ADM_VAR
    ' [UC-ADM-IMG]
    usecase "Manage Images\nand Embeddings" as UC_ADM_IMG
    ' [UC-ADM-TAX]
    usecase "Manage Taxonomies\nand Classification" as UC_ADM_TAX
    ' [UC-ADM-OPT]
    usecase "Manage Option\nTypes" as UC_ADM_OPT
    ' [UC-STR-BRW]
    usecase "Browse and Search\nCatalog" as UC_STR_BRW
    ' [UC-STR-SRC]
    usecase "Visual Search" as UC_STR_SRC
  }

  package "Ordering" {
    ' [UC-ADM-ORD]
    usecase "Manage Orders" as UC_ADM_ORD
    ' [UC-ADM-ORD-ITEMS]
    usecase "Manage Order\nDetails" as UC_ADM_ORD_ITEMS
    ' [UC-STR-CRT]
    usecase "Manage Cart" as UC_STR_CRT
    ' [UC-STR-CHK]
    usecase "Checkout" as UC_STR_CHK
    ' [UC-STR-OHI]
    usecase "Order History" as UC_STR_OHI
  }

  package "Payment" {
    ' [UC-ADM-PAY]
    usecase "Manage Payments" as UC_ADM_PAY
    ' [UC-ADM-PAY-METHOD]
    usecase "Manage Payment\nMethods" as UC_ADM_PAY_METHOD
    ' [UC-STR-PAY]
    usecase "Payment\nProcessing" as UC_STR_PAY
  }

  package "Inventory" {
    ' [UC-ADM-STK]
    usecase "Manage Stock" as UC_ADM_STK
    ' [UC-ADM-LOC]
    usecase "Manage Stock\nLocations" as UC_ADM_LOC
  }

  package "Identity" {
    ' [UC-ADM-USR]
    usecase "Manage Users" as UC_ADM_USR
    ' [UC-ADM-ROL]
    usecase "Manage Roles\nand Permissions" as UC_ADM_ROL
    ' [UC-STR-AUT]
    usecase "Authentication" as UC_STR_AUT
    ' [UC-STR-SES]
    usecase "Session\nManagement" as UC_STR_SES
  }

  package "Shipping" {
    ' [UC-ADM-SHP]
    usecase "Manage Shipping" as UC_ADM_SHP
  }

  package "Location" {
    ' [UC-ADM-REF]
    usecase "Manage Reference\nData" as UC_ADM_REF
  }

  package "Profile" {
    ' [UC-STR-PRF]
    usecase "Profile\nManagement" as UC_STR_PRF
  }

  package "System Services" {
    ' [UC-SYS-EMB]
    usecase "Embedding\nOperations" as UC_SYS_EMB
    ' [UC-SYS-MNT]
    usecase "System\nMaintenance" as UC_SYS_MNT
  }
}

Admin --> UC_ADM_PROD
Admin --> UC_ADM_VAR
Admin --> UC_ADM_IMG
Admin --> UC_ADM_TAX
Admin --> UC_ADM_OPT
Admin --> UC_ADM_ORD
Admin --> UC_ADM_ORD_ITEMS
Admin --> UC_ADM_PAY
Admin --> UC_ADM_PAY_METHOD
Admin --> UC_ADM_STK
Admin --> UC_ADM_LOC
Admin --> UC_ADM_USR
Admin --> UC_ADM_ROL
Admin --> UC_ADM_SHP
Admin --> UC_ADM_REF

Customer --> UC_STR_BRW
Customer --> UC_STR_SRC
Customer --> UC_STR_CRT
Customer --> UC_STR_CHK
Customer --> UC_STR_OHI
Customer --> UC_STR_PAY
Customer --> UC_STR_AUT
Customer --> UC_STR_SES
Customer --> UC_STR_PRF

SysActor --> UC_SYS_EMB
SysActor --> UC_SYS_MNT

UC_STR_CHK ..> UC_STR_PAY : <<include>>
UC_STR_CHK ..> UC_STR_AUT : <<include>>
UC_STR_SRC ..> UC_SYS_EMB : <<include>>
UC_ADM_IMG ..> UC_SYS_EMB : <<include>>
UC_ADM_ORD ..> UC_STR_PAY : <<include>>
UC_STR_OHI ..> UC_STR_AUT : <<include>>

@enduml
