@startuml c4-context
!include <C4/C4_Context>
!include <C4/C4_Container>

LAYOUT_WITH_LEGEND()

title System Context — ReSys.Shop E-Commerce Platform

Person(customer, "Customer", "Browses products, searches by image, purchases items")
Person(admin, "Administrator", "Manages products, orders, users, shipping")

System_Boundary(c1, "ReSys.Shop System") {
    System(resys, "E-Commerce Platform", "Modular monolith: Vue 3 SPAs + .NET 10 API")
    System(ml_sidecar, "Python ML Sidecar", "Image embedding generation (Fashion-CLIP)")
}

System_Ext(stripe, "Stripe", "Payment processing and webhook sender")
System_Ext(sendgrid, "SendGrid / SMTP", "Transactional email delivery")
System_Ext(s3, "S3-Compatible Storage", "Object storage for product images")
System_Ext(google, "Google OAuth", "External identity provider")

Rel(customer, resys, "Searches, browses, checks out", "HTTPS")
Rel(admin, resys, "Administers catalog, orders, users", "HTTPS")
Rel(stripe, resys, "POSTs payment events", "HTTPS (webhook)")
Rel(resys, sendgrid, "Sends transactional emails", "SMTP / HTTPS")
Rel(resys, s3, "Stores/retrieves images", "HTTPS (S3 API)")
Rel(resys, google, "Redirects for OAuth login", "HTTPS (OAuth 2.0)")
Rel(resys, ml_sidecar, "Requests image embeddings", "HTTP internal")

@enduml
