%%{init: {'theme': 'neutral', 'themeVariables': {'fontSize': '78px'}}}%%
erDiagram

  %% ==================== CATALOG (catalog) ====================

  Product {
    uuid id PK
    string slug UK
    string name
    string status
    uuid master_variant_id FK
  }

  Variant {
    uuid id PK
    uuid product_id FK
    bool is_master
    string sku UK
    decimal price
  }

  VariantImage {
    uuid id PK
    uuid variant_id FK
    string url
  }

  VariantImageEmbedding {
    uuid id PK
    uuid variant_image_id FK
    string model_name
    vector(512) vector
  }

  OptionType {
    uuid id PK
    string name
  }

  OptionValue {
    uuid id PK
    uuid option_type_id FK
    string name
  }

  ProductOptionType {
    uuid id PK
    uuid product_id FK
    uuid option_type_id FK
  }

  OptionValueVariant {
    uuid id PK
    uuid variant_id FK
    uuid option_value_id FK
  }

  Taxonomy {
    uuid id PK
    string name
  }

  Taxon {
    uuid id PK
    uuid taxonomy_id FK
    uuid parent_id FK
    string name
    string slug
  }

  Classification {
    uuid id PK
    uuid product_id FK
    uuid taxon_id FK
  }

  %% ==================== IDENTITY (identity) ====================

  User {
    uuid id PK
    string email UK
    string password_hash
  }

  Role {
    uuid id PK
    string name UK
  }

  UserRole {
    uuid user_id PK
    uuid role_id PK
  }

  RefreshToken {
    uuid id PK
    uuid user_id FK
    string token_hash
  }

  UserLogin {
    uuid user_id PK
    string login_provider PK
    string provider_key
  }

  %% ==================== ORDERING (ordering) ====================

  Order {
    uuid id PK
    string number UK
    uuid user_id
    uuid bill_address_id
    uuid ship_address_id
    string status
    string checkout_state
    string payment_state
    string shipment_state
    decimal total
    datetime completed_at_utc
  }

  LineItem {
    uuid id PK
    uuid order_id FK
    uuid variant_id FK
    int quantity
    decimal price
  }

  Adjustment {
    uuid id PK
    uuid order_id FK
    decimal amount
  }

  %% ==================== PAYMENT (payment) ====================

  PaymentMethod {
    uuid id PK
    string name
    string provider_key
  }

  PaymentCapture {
    uuid id PK
    uuid order_id FK
    uuid payment_method_id FK
    decimal amount
    string state
    string stripe_payment_intent_id
  }

  WebhookEvent {
    uuid id PK
    string stripe_event_id UK
    string type
  }

  %% ==================== INVENTORY (inventory) ====================

  StockLocation {
    uuid id PK
    string code
    string name
  }

  StockItem {
    uuid id PK
    uuid variant_id FK
    uuid stock_location_id FK
    int count_on_hand
  }

  StockMovement {
    uuid id PK
    uuid stock_item_id FK
    int quantity
  }

  StockReservation {
    uuid id PK
    uuid variant_id FK
    uuid stock_location_id FK
    uuid order_id
    int quantity
    string state
  }

  StockTransfer {
    uuid id PK
    string number
    uuid source_location_id FK
    uuid destination_location_id FK
  }

  TransferItem {
    uuid id PK
    uuid stock_transfer_id FK
    uuid variant_id FK
    int quantity
  }

  %% ==================== SHIPPING (shipping) ====================

  ShippingMethod {
    uuid id PK
    string name
    string code
  }

  ShippingRate {
    uuid id PK
    uuid shipping_method_id FK
    decimal cost
  }

  ShippingMethodZone {
    uuid id PK
    uuid shipping_method_id FK
    string country_code
  }

  Shipment {
    uuid id PK
    uuid order_id FK
    uuid shipping_method_id FK
    string tracking_number
    string status
  }

  %% ==================== LOCATION (location) ====================

  Country {
    uuid id PK
    string iso_code UK
    string name
  }

  State {
    uuid id PK
    uuid country_id FK
    string name
  }

  %% ==================== PROFILE (profile) ====================

  UserProfile {
    uuid id PK
    uuid user_id FK
    string email
  }

  Address {
    uuid id PK
    uuid user_profile_id FK
    string address_type
  }

  Wishlist {
    uuid id PK
    uuid user_id FK
    string name
  }

  WishedItem {
    uuid id PK
    uuid wishlist_id FK
    uuid variant_id FK
    int quantity
  }

  %% ==================== RELATIONSHIPS ====================

  %% -- Catalog (same schema, solid) --
  Product ||--o{ Variant : ""
  Product ||--o{ ProductOptionType : ""
  Product ||--o{ Classification : ""
  Variant ||--o{ VariantImage : ""
  VariantImage ||--o{ VariantImageEmbedding : ""
  OptionType ||--o{ OptionValue : ""
  OptionType ||--o{ ProductOptionType : ""
  OptionValue ||--o{ OptionValueVariant : ""
  Variant ||--o{ OptionValueVariant : ""
  Taxonomy ||--o{ Taxon : ""
  Taxon ||--o{ Taxon : "parent"
  Taxon ||--o{ Classification : ""

  %% -- Identity (same schema, solid) --
  User ||--o{ UserRole : ""
  Role ||--o{ UserRole : ""
  User ||--o{ RefreshToken : ""
  User ||--o{ UserLogin : ""

  %% -- Ordering (same schema, solid) --
  Order ||--o{ LineItem : ""
  Order ||--o{ Adjustment : ""

  %% -- Payment (same schema, solid) --
  PaymentMethod ||--o{ PaymentCapture : ""

  %% -- Inventory (same schema, solid) --
  StockLocation ||--o{ StockItem : ""
  StockLocation ||--o{ StockMovement : ""
  StockItem ||--o{ StockMovement : ""
  StockLocation ||--o{ StockReservation : ""
  StockLocation ||--o{ StockTransfer : "source"
  StockLocation ||--o{ StockTransfer : "dest"
  StockTransfer ||--o{ TransferItem : ""

  %% -- Shipping (same schema, solid) --
  ShippingMethod ||--o{ ShippingRate : ""
  ShippingMethod ||--o{ ShippingMethodZone : ""

  %% -- Location (same schema, solid) --
  Country ||--o{ State : ""

  %% -- Profile (same schema, solid) --
  UserProfile ||--o{ Address : ""
  Wishlist ||--o{ WishedItem : ""

  %% -- Cross-context identifier references (dotted) --
  Order |o--o{ PaymentCapture : ""
  Order |o--o{ Shipment : ""
  Order |o--o{ StockReservation : ""
  Order |o--o{ PaymentMethod : ""
  Order |o--o{ ShippingMethod : ""
  Order |o--o{ Address : "bill/ship"
  LineItem |o--o{ Variant : ""
  Variant |o--o{ StockItem : ""
  Variant |o--o{ StockReservation : ""
  Variant |o--o{ TransferItem : ""
  Variant |o--o{ WishedItem : ""
  StockLocation |o--o{ Country : ""
  StockLocation |o--o{ State : ""
  User |o--o{ Order : ""
  User |o--o{ UserProfile : ""
  User |o--o{ Wishlist : ""
  Shipment |o--o{ ShippingMethod : ""
  Shipment |o--o{ Address : ""
