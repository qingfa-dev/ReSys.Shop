@startuml payment-state-machine

skinparam backgroundColor White
skinparam DefaultFontSize 13
skinparam DefaultFontName Arial
skinparam shadowing false

skinparam activity {
  BackgroundColor #F7F9FA
  BorderColor #263238
  BorderThickness 2
  FontSize 13
}

skinparam diamond {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
  FontSize 12
}

start

:Create Payment Intent\nState = **Pending**;

if (3D Secure\nrequired?) then (yes)
  :State =\n**RequiresAction**;
  if (Customer\nauthenticates?) then (yes)
    :State =\n**Processing**;
  else (no)
    :State =\n**Canceled**;
    stop
  endif
else (no)
  :State =\n**Processing**;
endif

if (Charge\nsucceeds?) then (yes)
  :State =\n**Succeeded**;
  
  if (Capture\nfunds?) then (yes)
    :State =\n**Captured**;
    
    if (Refund?) then (yes)
      :State =\n**Refunded**;
      stop
    else (no)
      :Fulfillment\ncomplete;
      stop
    endif
  else (no)
    :State =\n**Canceled**;
    stop
  endif
else (no)
  :State =\n**Failed**;
  :Retry or\nabandon;
  stop
endif

note right
  Local state mirrors
  gateway responses
  for offline operation
end note

@enduml
