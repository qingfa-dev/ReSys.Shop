%%{init: {'theme': 'base', 'themeVariables': { 'fontSize': '28px', 'fontFamily': 'Arial', 'primaryColor': '#ffffff', 'edgeLabelBackground':'#ffffff', 'tertiaryColor': '#ffffff', 'primaryBorderColor': '#333333', 'lineColor': '#555555' }}}%%
flowchart TB
    classDef mainNode fill:#ffffff,stroke:#333333,stroke-width:2.5px
    classDef backboneNode fill:#f8f9fa,stroke:#444444,stroke-width:1.5px
    classDef trainNode fill:#ffffff,stroke:#666666,stroke-width:1.5px,stroke-dasharray: 4 2
    classDef outputNode fill:#f4f4f4,stroke:#222222,stroke-width:2px

    %% INPUT & STEM STAGE
    A["Input Image<br/>(224 x 224 x 3)"]:::mainNode --> B["Stem Stage<br/>3x3 Conv, Stride 2<br/>(112 x 112 x 32)"]:::backboneNode

    %% EFFICIENTNET-B0 BACKBONE STAGE (SPLIT INTO TWO LEFT-TO-RIGHT ROWS)
    subgraph Backbone["EfficientNet-B0 Backbone (7 MBConv Stages)"]
        direction TB
        
        %% ROW 1: STAGES 1 TO 4 (LR)
        subgraph Row1 ["First Half (Stages 1–4)"]
            direction LR
            Stage1["Stage 1: MBConv1 (3x3)<br/>(112 x 112 x 16)"]:::backboneNode --> Stage2["Stage 2: 2x MBConv6 (3x3)<br/>(56 x 56 x 24)"]:::backboneNode
            Stage2 --> Stage3["Stage 3: 2x MBConv6 (5x5)<br/>(28 x 28 x 40)"]:::backboneNode
            Stage3 --> Stage4["Stage 4: 3x MBConv6 (3x3)<br/>(14 x 14 x 80)"]:::backboneNode
        end

        %% ROW 2: STAGES 5 TO 7 + EXPANSION HEAD (LR)
        subgraph Row2 ["Second Half (Stages 5–7)"]
            direction LR
            Stage5["Stage 5: 3x MBConv6 (5x5)<br/>(14 x 14 x 112)"]:::backboneNode --> Stage6["Stage 6: 4x MBConv6 (5x5)<br/>(7 x 7 x 192)"]:::backboneNode
            Stage6 --> Stage7["Stage 7: MBConv6 (3x3)<br/>(7 x 7 x 320)"]:::backboneNode
            Stage7 --> ConvHead["1x1 Conv Expansion<br/>(7 x 7 x 1280)"]:::backboneNode
        end

        %% LINK ROW 1 TO ROW 2
        Stage4 ==> Stage5
    end

    B ==> Stage1

    %% PRE-TRAINING SUBSYSTEM
    subgraph PT["Supervised / Self-Supervised Pre-training"]
        direction LR
        F["ImageNet-1k / Catalog Data"]:::trainNode --> G["Cross-Entropy /<br/>Metric Learning Loss"]:::trainNode
    end
    PT -. "Pre-trains Backbone" .-> Backbone

    %% RIGHT-SIDE RETRIEVAL PIPELINE
    subgraph OutputPipeline ["Feature Extraction & Retrieval Pipeline"]
        direction LR
        GAP["Global Average Pooling (GAP)<br/>(Spatial Reduction → 1280-dim)"]:::outputNode --> Proj["Linear Projection Head<br/>(Optional → 256/512-dim)"]:::backboneNode
        Proj --> Norm["L2 Vector Normalization<br/>(||v||₂ = 1)"]:::backboneNode
        Norm --> D["K-NN Cosine Similarity Search<br/>(Catalog Retrieval & Recommendations)"]:::outputNode
    end

    %% CONNECTION FROM EXPANSION HEAD TO RETRIEVAL PIPELINE
    ConvHead ==> GAP