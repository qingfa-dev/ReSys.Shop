%%{init: {'theme': 'base', 'themeVariables': { 'fontSize': '28px', 'fontFamily': 'arial', 'primaryColor': '#ffffff', 'edgeLabelBackground':'#ffffff', 'tertiaryColor': '#ffffff', 'primaryBorderColor': '#333333', 'lineColor': '#555555' }}}%%
flowchart TB
    classDef imgNode fill:#fafafa,stroke:#555,stroke-width:2px
    classDef txtNode fill:#f8f8f8,stroke:#555,stroke-width:2px
    classDef sharedNode fill:#fff,stroke:#333,stroke-width:3px
    classDef outputNode fill:#fafafa,stroke:#333,stroke-width:3px
    classDef trainNode fill:#fff,stroke:#777,stroke-width:2px,stroke-dasharray: 4 2

    subgraph IMG["Image Tower"]
        direction TB
        A["Product Image"]:::imgNode --> B["ViT-B/16 Encoder"]:::imgNode
        B --> C["512-dim Embedding"]:::imgNode
    end

    subgraph TXT["Text Tower"]
        direction TB
        D["Text Description (Bohemian style maxi dress)"]:::txtNode --> E["Text Transformer Encoder"]:::txtNode
        E --> F["512-dim Embedding"]:::txtNode
    end

    C --> G["Shared Latent Space"]:::sharedNode
    F --> G
    G --> H["Cosine Similarity"]:::sharedNode
    H --> I["Similarity Score"]:::outputNode

    J["Fine-Tuned on 700K Fashion Image-Text Pairs"]:::trainNode
    J -.-> IMG
    J -.-> TXT
