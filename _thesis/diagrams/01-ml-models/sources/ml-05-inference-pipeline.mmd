%%{init: {'theme': 'base', 'themeVariables': { 'fontSize': '32px', 'fontFamily': 'arial', 'primaryColor': '#ffffff', 'edgeLabelBackground':'#ffffff', 'tertiaryColor': '#ffffff' }}}%%
flowchart TB
    %% Styles (Grayscale)
    classDef client fill:#ffffff,stroke:#000000,stroke-width:2px,color:black,font-size:16px;
    classDef api fill:#f8f8f8,stroke:#000000,stroke-width:2px,color:black,font-size:16px;
    classDef logic fill:#ffffff,stroke:#000000,stroke-width:1px,stroke-dasharray: 5 5,color:black,font-size:16px;
    classDef gpu fill:#eeeeee,stroke:#000000,stroke-width:2px,color:black,font-size:16px;

    %% Nodes
    Client(["Client Request"]):::client
    Validator["Validator\n(Pydantic)"]:::api
    
    subgraph Manager [Model Manager]
        Check{Cache Hit?}:::logic
        Load["Lazy Load\n(Disk I/O)"]:::logic
        Pre["Pre-process\n(Resize/Norm)"]:::logic
    end
    
    subgraph Device [Inference Engine]
        Infer["Forward Pass\n(CUDA)"]:::gpu
        Post["Post-process\n(Flatten)"]:::gpu
    end
    
    Response(["JSON Vector"]):::client

    %% Edges
    Client -->|POST /embed| Validator
    Validator --> Check
    Check -- No --> Load
    Load --> Pre
    Check -- Yes --> Pre
    Pre --> Infer
    Infer --> Post
    Post --> Response
