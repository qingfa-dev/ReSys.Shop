%%{init: {'theme': 'base', 'themeVariables': { 'fontSize': '32px', 'fontFamily': 'arial', 'primaryColor': '#ffffff', 'edgeLabelBackground':'#ffffff', 'tertiaryColor': '#ffffff' }}}%%
stateDiagram-v2
    %% Styles (Grayscale)
    classDef idle fill:#ffffff,stroke:#000000,stroke-width:2px,color:black,font-weight:bold,font-size:16px;
    classDef active fill:#e0e0e0,stroke:#000000,stroke-width:2px,color:black,font-weight:bold,font-size:16px;
    classDef trans fill:#ffffff,stroke:#000000,stroke-width:1px,stroke-dasharray: 5 5,color:black,font-size:14px;

    [*] --> Unloaded:::idle

    Unloaded --> Loading:::trans : 1. First Request
    Loading --> Ready:::active : 2. Weights to GPU
    
    state Ready {
        Inference : Active Processing
        Idle : Waiting in VRAM
        
        [*] --> Inference
        Inference --> Idle
        Idle --> Inference : Subsequent Requests
    }

    Ready --> Evicting:::trans : 3. LRU Timeout
    Evicting --> Unloaded : 4. Free Memory
