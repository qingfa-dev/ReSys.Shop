@startuml
!theme plain
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false

left to right direction

' Actors
actor "Customer" as Customer
actor "Admin" as Admin
actor "Guest" as Guest

' System boundary
rectangle "ReSys.Shop E-Commerce System" {
  
  ' Product Browsing
  usecase "Browse Products" as UC1
  usecase "View Product Details" as UC2
  usecase "Filter by Category" as UC3
  
  ' Visual Search
  usecase "Visual Search" as UC4
  usecase "Upload Image" as UC5
  usecase "View Similar Products" as UC6
  
  ' Shopping Cart
  usecase "Add to Cart" as UC7
  usecase "View Cart" as UC8
  usecase "Update Quantity" as UC9
  
  ' Checkout
  usecase "Checkout" as UC10
  usecase "Enter Shipping Info" as UC11
  usecase "Process Payment" as UC12
  usecase "Login" as UC13
  
  ' Admin Functions
  usecase "Manage Inventory" as UC14
  usecase "View Analytics" as UC15
  usecase "Manage Orders" as UC16
  
  ' Include relationships (mandatory)
  UC4 ..> UC5 : <<include>>
  UC4 ..> UC6 : <<include>>
  UC10 ..> UC13 : <<include>>
  UC10 ..> UC11 : <<include>>
  UC10 ..> UC12 : <<include>>
  
  ' Extend relationships (optional)
  UC1 ..> UC3 : <<extend>>
  UC8 ..> UC9 : <<extend>>
}

' Actor-Use Case Associations
Guest --> UC1
Guest --> UC2
Guest --> UC4

Customer --> UC1
Customer --> UC2
Customer --> UC4
Customer --> UC7
Customer --> UC8
Customer --> UC10

Admin --> UC13
Admin --> UC14
Admin --> UC15
Admin --> UC16

note right of UC4
  Core feature: Image-based
  product search using
  Fashion-CLIP embeddings
end note

note right of UC10
  Requires authentication
  and shipping information
end note

@enduml
