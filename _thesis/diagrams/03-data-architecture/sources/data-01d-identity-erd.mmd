%%{init: {'theme': 'base', 'themeVariables': { 'fontSize': '20px', 'fontFamily': 'arial'}}}%%
erDiagram
    users {
        string id PK
        string email
        string username
        string password_hash
    }
    
    user_addresses {
        uuid id PK
        string user_id FK
        string street
        string city
        string country
    }
    
    roles {
        string id PK
        string name
    }
    
    user_roles {
        string user_id FK
        string role_id FK
    }
    
    refresh_tokens {
        uuid id PK
        string user_id FK
        string token
        timestamp expires_at
    }
    
    customer_profiles {
        string user_id PK
        decimal loyalty_points
    }
    
    staff_profiles {
        string user_id PK
        string employee_id
        string department
    }

    users ||--o{ user_addresses : "has"
    users ||--o{ user_roles : "assigned"
    users ||--o{ refresh_tokens : "has"
    users ||--|| customer_profiles : "extends"
    users ||--|| staff_profiles : "extends"
    roles ||--o{ user_roles : "grants"
