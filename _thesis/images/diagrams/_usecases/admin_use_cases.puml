@startuml sq-0009
!theme plain
title UC-0009: Product Image Upload

actor Admin
participant "Admin Panel" as FE
participant "Catalog API" as API
participant "Blob Storage" as Blob
queue "Message Bus" as Bus

Admin -> FE: Upload Image
activate FE
FE -> FE: Validate (<10MB)
FE -> FE: Generate Thumbnail
FE -> Blob: Upload Original & Thumb
activate Blob
Blob --> FE: URLs
deactivate Blob
FE -> API: CreateImageRecord(URLs)
activate API
API -> Bus: Publish(ImageUploaded)
activate Bus
Bus --> API: Ack
deactivate Bus
API --> FE: Success (Pending)
deactivate API
FE --> Admin: Show in Gallery
deactivate FE
@enduml

