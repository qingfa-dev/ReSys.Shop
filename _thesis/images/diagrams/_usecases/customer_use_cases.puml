@startuml sq-0001
!theme plain
title UC-0001: Visual Search by Image Upload

actor Customer
participant "Frontend" as FE
participant "Backend API" as API
participant "ML Service" as ML
database "Vector DB" as DB

Customer -> FE: Upload Image
activate FE
FE -> FE: Validate File (<10MB)
FE -> API: POST /search/image
activate API
API -> ML: POST /embed
activate ML
ML -> ML: Generate Embedding
ML --> API: Vector (512-dim)
deactivate ML
API -> DB: Query(Vector)
activate DB
DB --> API: Top-K Results
deactivate DB
API --> FE: Ranked Products
deactivate API
FE --> Customer: Display Grid
deactivate FE
@enduml

@startuml sq-0002
!theme plain
title UC-0002: Perform Multi-step Checkout

actor Customer
participant "Frontend" as FE
participant "Order Service" as API
participant "Payment Gateway" as PG
database "Database" as DB

Customer -> FE: Proceed to Checkout
activate FE
FE -> Customer: Request Address
Customer -> FE: Select Address
FE -> Customer: Request Payment
Customer -> FE: Enter Payment Details
Customer -> FE: Place Order
FE -> API: CreateOrder()
activate API
API -> DB: Reserve Inventory
activate DB
DB --> API: Reserved
deactivate DB
API -> PG: Process Payment
activate PG
PG --> API: Success
deactivate PG
API -> DB: Save Order
activate DB
DB --> API: Saved
deactivate DB
API --> FE: Order Confirmed
deactivate API
FE --> Customer: Show Success Page
deactivate FE
@enduml

