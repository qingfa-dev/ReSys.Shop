# =============================================================================
# Webhooks - Admin Subscriptions API Smoke Tests
# =============================================================================
# @baseUrl          = {{baseUrl}}
# @contentType      = {{contentType}}
# @adminToken       = {{adminToken}}
# @nonExistentId    = {{nonExistentId}}
# =============================================================================

### ---------------------------------------------------------------------------
### 1. Create webhook subscription – success (200)
# POST /api/webhooks/subscriptions
# Expected: 200 OK with subscription ID
# ---------------------------------------------------------------------------
# @name createSubscription
POST {{baseUrl}}/api/webhooks/subscriptions
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "event": "order.placed",
  "url": "https://example.com/webhook",
  "secret": "whsec_test",
  "maxRetries": 3
}

### ---------------------------------------------------------------------------
### 2. Get webhook subscription by ID – success (200)
# GET /api/webhooks/subscriptions/{id}
# Expected: 200 OK with subscription details
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/webhooks/subscriptions/{{createSubscription.response.body.$.value.id}}
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------------
### 3. Update webhook subscription – success (200)
# PUT /api/webhooks/subscriptions/{id}
# Expected: 200 OK
# ---------------------------------------------------------------------------
PUT {{baseUrl}}/api/webhooks/subscriptions/{{createSubscription.response.body.$.value.id}}
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "event": "order.placed",
  "url": "https://updated-example.com/webhook",
  "secret": "whsec_updated",
  "maxRetries": 5
}

### ---------------------------------------------------------------------------
### 4. Delete webhook subscription – success (200)
# DELETE /api/webhooks/subscriptions/{id}
# Expected: 200 OK
# ---------------------------------------------------------------------------
DELETE {{baseUrl}}/api/webhooks/subscriptions/{{createSubscription.response.body.$.value.id}}
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------------
### 5. Get deleted webhook subscription – not found (404)
# GET /api/webhooks/subscriptions/{id}
# Expected: 404 Not Found
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/webhooks/subscriptions/{{createSubscription.response.body.$.value.id}}
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------------
### 6. List webhook subscriptions – success (200)
# GET /api/webhooks/subscriptions?page=1&pageSize=10
# Expected: 200 OK with paged results
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/webhooks/subscriptions?page=1&pageSize=10
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------------
### 7. Get webhook subscription by ID – not found (404)
# GET /api/webhooks/subscriptions/{nonExistentId}
# Expected: 404 Not Found
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/webhooks/subscriptions/{{nonExistentId}}
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------------
### 8. Create webhook subscription – no auth (401)
# POST /api/webhooks/subscriptions
# Expected: 401 Unauthorized
# ---------------------------------------------------------------------------
POST {{baseUrl}}/api/webhooks/subscriptions
Content-Type: {{contentType}}

{
  "event": "order.placed",
  "url": "https://example.com/webhook",
  "secret": "whsec_test"
}

### ---------------------------------------------------------------------------
### 9. Test webhook delivery – success (200)
# POST /api/webhooks/subscriptions/{id}/test
# Expected: 200 OK with delivery ID and status
# ---------------------------------------------------------------------------
# @name testSubscription
POST {{baseUrl}}/api/webhooks/subscriptions/{{createSubscription.response.body.$.value.id}}/test
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------------
### 10. Test webhook delivery – not found (404)
# POST /api/webhooks/subscriptions/{nonExistentId}/test
# Expected: 404 Not Found
# ---------------------------------------------------------------------------
POST {{baseUrl}}/api/webhooks/subscriptions/{{nonExistentId}}/test
Authorization: Bearer {{adminToken}}
