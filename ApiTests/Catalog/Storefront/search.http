# =============================================================================
# ReSys.Shop API Test - Storefront Catalog Search
# =============================================================================
# @baseUrl     = {{baseUrl}}
# @contentType = {{contentType}}
# =============================================================================

### ---------------------------------------------------------------------------
### 1. Search by keyword
# GET /api/storefront/search?q=t-shirt
# Expected: 200 OK – search results matching "t-shirt"
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/storefront/search?q=t-shirt
Content-Type: {{contentType}}

### ---------------------------------------------------------------------------
### 2. Search – empty results
# GET /api/storefront/search?q=zzzzzzzz
# Expected: 200 OK – empty result set (no matches)
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/storefront/search?q=zzzzzzzz
Content-Type: {{contentType}}

### ---------------------------------------------------------------------------
### 3. Search – without query (returns all)
# GET /api/storefront/search
# Expected: 200 OK – full list of products
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/storefront/search
Content-Type: {{contentType}}

### ---------------------------------------------------------------------------
### 4. Filter by color
# GET /api/storefront/filter?color=Red
# Expected: 200 OK – products filtered by color
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/storefront/filter?color=Red
Content-Type: {{contentType}}

### ---------------------------------------------------------------------------
### 5. Filter by price range
# GET /api/storefront/filter?minPrice=10&maxPrice=100
# Expected: 200 OK – products within price range
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/storefront/filter?minPrice=10&maxPrice=100
Content-Type: {{contentType}}

### ---------------------------------------------------------------------------
### 6. Filter by size
# GET /api/storefront/filter?size=M
# Expected: 200 OK – products matching size M
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/storefront/filter?size=M
Content-Type: {{contentType}}

### ---------------------------------------------------------------------------
### 7. Combined filter
# GET /api/storefront/filter?color=Blue&minPrice=20&maxPrice=200
# Expected: 200 OK – products matching all filters
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/storefront/filter?color=Blue&minPrice=20&maxPrice=200
Content-Type: {{contentType}}
