# =============================================================================
# ReSys.Shop API Test - Admin Catalog Option Types
# =============================================================================
# @baseUrl        = {{baseUrl}}
# @contentType    = {{contentType}}
# @adminToken     = {{adminToken}}
# @nonExistentId  = {{nonExistentId}}
# =============================================================================

### ---------------------------------------------------------------------------
### 1. Create option type – success
# POST /api/catalog/option-types
# Expected: 201 Created with location header
# ---------------------------------------------------------------------------
POST {{baseUrl}}/api/catalog/option-types
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "name": "Size",
  "displayName": "Size",
  "position": 1
}

### ---------------------------------------------------------------------------
### 2. Create option type – duplicate name
# POST /api/catalog/option-types
# Expected: 409 Conflict – name already exists
# ---------------------------------------------------------------------------
POST {{baseUrl}}/api/catalog/option-types
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "name": "Size",
  "displayName": "Size",
  "position": 2
}

### ---------------------------------------------------------------------------
### 3. Create option type – validation error
# POST /api/catalog/option-types
# Expected: 400 Bad Request – name is required
# ---------------------------------------------------------------------------
POST {{baseUrl}}/api/catalog/option-types
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "name": "",
  "displayName": "",
  "position": 0
}

### ---------------------------------------------------------------------------
### 4. List option types (paged)
# GET /api/catalog/option-types
# Expected: 200 OK – paged list of option types
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/catalog/option-types?page={{page}}&pageSize={{pageSize}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------------
### 5. Get option type by ID – success
# GET /api/catalog/option-types/{id}
# Expected: 200 OK – single option type
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/catalog/option-types/{{existingOptionTypeId}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------------
### 6. Get option type by ID – not found
# GET /api/catalog/option-types/{id}
# Expected: 404 Not Found
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/catalog/option-types/{{nonExistentId}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------------
### 7. Update option type – success
# PUT /api/catalog/option-types/{id}
# Expected: 200 OK – updated option type
# ---------------------------------------------------------------------------
PUT {{baseUrl}}/api/catalog/option-types/{{existingOptionTypeId}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "name": "Size",
  "displayName": "Garment Size",
  "position": 1
}

### ---------------------------------------------------------------------------
### 8. Delete option type – success
# DELETE /api/catalog/option-types/{id}
# Expected: 200 OK (or 204 No Content)
# ---------------------------------------------------------------------------
DELETE {{baseUrl}}/api/catalog/option-types/{{existingOptionTypeId}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------------
### 9. No authentication – 401
# GET /api/catalog/option-types
# Expected: 401 Unauthorized – missing or invalid token
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/catalog/option-types
Content-Type: {{contentType}}
