{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Observability": {
    "UseAspireOTLPExporter": false,
    "ExposeDetailedReport": true
  },
  "Caching": {
    "Enabled": false,
    "Memory": {
      "Enabled": false
    },
    "Distributed": {
      "Enabled": false
    },
    "Hybrid": {
      "Enabled": false
    }
  },
  "BackgroundJobs": {
    "Enabled": false,
    "DashboardPath": "/jobs"
  },
  "Storage": {
    "Enabled": false,
    "Security": {
      "MaxFileSizeBytes": 10485760
    },
    "AntiForgery": {
      "MaxConsecutiveFailures": 5,
      "BlockDuration": "00:15:00"
    },
    "MalwareScanner": {
      "Enabled": false
    },
    "Providers": {
      "Local": {
        "IsEnabled": false
      },
      "Azure": {
        "IsEnabled": false
      }
    }
  },
  "Authentication": {
    "Jwt": {
      "Secret": "integration-test-secret-key-32-chars!!",
      "Issuer": "ReSys.Shop.Test",
      "Audience": "ReSys.Shop.Test",
      "AccessTokenExpirationInMinutes": 60,
      "RefreshTokenExpirationInDays": 1,
      "Algorithm": "HS256",
      "TokenSecurity": {
        "RotationEnabled": false,
        "ReuseDetectionEnabled": false,
        "SlidingExpirationEnabled": false,
        "MaxTokenAgeDays": 1
      }
    },
    "Google": {
      "ClientId": "test-client-id",
      "ClientSecret": "test-client-secret"
    }
  },
  "Notification": {
    "EnableBackgroundJobs": false,
    "Channels": {
      "Email": {
        "Enabled": false,
        "Providers": {
          "SendGrids": {
            "Enabled": false
          },
          "Smtp": {
            "Enabled": false
          }
        }
      },
      "Sms": {
        "Enabled": false,
        "Providers": {
          "Sinch": {
            "Enabled": false
          }
        }
      }
    }
  },
  "GuestSession": {
    "CookieName": "session_id",
    "CookieSameSite": "Lax",
    "CookieSecurePolicy": "SameAsRequest",
    "CookieHttpOnly": true,
    "ExpirationInDays": 365
  },
  "AntiForgery": {
    "IsEnabled": false,
    "Required": false,
    "CookieName": "XSRF-TOKEN",
    "CookieSameSite": "Strict",
    "CookieSecurePolicy": "SameAsRequest",
    "CookieHttpOnly": true,
    "CookieMaxAgeMinutes": null
  },
  "Authorization": {
    "PermissionCache": {
      "SlidingExpiration": "00:05:00",
      "AbsoluteExpiration": "00:30:00"
    }
  },
  "Cors": {
    "Origins": [],
    "AllowCredentials": true
  }
}
