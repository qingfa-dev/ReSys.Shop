# =============================================================================
# ReSys.Shop API Test - Store Location States
# =============================================================================
# @baseUrl        = {{baseUrl}}
# @contentType    = {{contentType}}
# @nonExistentId  = {{nonExistentId}}
# @existingCountryId = {{existingCountryId}}
# =============================================================================

### ---------------------------------------------------------------------------
### 1. List states (default pagination)
# GET /api/storefront/locations/states
# Expected: 200 OK – paged list of states (public, no auth required)
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/storefront/locations/states?page={{page}}&pageSize={{pageSize}}
Content-Type: {{contentType}}

### ---------------------------------------------------------------------------
### 2. List states filtered by country
# GET /api/storefront/locations/states?countryId={id}
# Expected: 200 OK – states belonging to the specified country
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/storefront/locations/states?countryId={{existingCountryId}}&page={{page}}&pageSize={{pageSize}}
Content-Type: {{contentType}}

### ---------------------------------------------------------------------------
### 3. Get state by ID – success
# GET /api/storefront/locations/states/{id}
# Expected: 200 OK – single state
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/storefront/locations/states/{{existingStateId}}
Content-Type: {{contentType}}

### ---------------------------------------------------------------------------
### 4. Get state by ID – not found
# GET /api/storefront/locations/states/{id}
# Expected: 404 Not Found
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/storefront/locations/states/{{nonExistentId}}
Content-Type: {{contentType}}

### ---------------------------------------------------------------------------
### 5. Get state by ISO code – success
# GET /api/storefront/locations/states/by-iso/{isoCode}
# Expected: 200 OK – single state
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/storefront/locations/states/by-iso/US-CA
Content-Type: {{contentType}}

### ---------------------------------------------------------------------------
### 6. Get state by ISO code – not found
# GET /api/storefront/locations/states/by-iso/{isoCode}
# Expected: 404 Not Found
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/storefront/locations/states/by-iso/XX-YY
Content-Type: {{contentType}}

### ---------------------------------------------------------------------------
### 7. List states – custom pagination
# GET /api/storefront/locations/states
# Expected: 200 OK – paged list with page=2&pageSize=3
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/storefront/locations/states?page=2&pageSize=3
Content-Type: {{contentType}}
