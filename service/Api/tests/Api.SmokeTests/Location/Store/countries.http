# =============================================================================
# ReSys.Shop API Test - Store Location Countries
# =============================================================================
# @baseUrl        = {{baseUrl}}
# @contentType    = {{contentType}}
# @nonExistentId  = {{nonExistentId}}
# =============================================================================

### ---------------------------------------------------------------------------
### 1. List countries (default pagination)
# GET /api/store/locations/countries
# Expected: 200 OK – paged list of countries (public, no auth required)
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/store/locations/countries?page={{page}}&pageSize={{pageSize}}
Content-Type: {{contentType}}

### ---------------------------------------------------------------------------
### 2. List countries – custom pagination
# GET /api/store/locations/countries
# Expected: 200 OK – paged list with page=1&pageSize=5
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/store/locations/countries?page=1&pageSize=5
Content-Type: {{contentType}}

### ---------------------------------------------------------------------------
### 3. Get country by ID – success
# GET /api/store/locations/countries/{id}
# Expected: 200 OK – single country
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/store/locations/countries/{{existingCountryId}}
Content-Type: {{contentType}}

### ---------------------------------------------------------------------------
### 4. Get country by ID – not found
# GET /api/store/locations/countries/{id}
# Expected: 404 Not Found
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/store/locations/countries/{{nonExistentId}}
Content-Type: {{contentType}}

### ---------------------------------------------------------------------------
### 5. Get country by ISO code – success
# GET /api/store/locations/countries/by-iso/{isoCode}
# Expected: 200 OK – single country
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/store/locations/countries/by-iso/US
Content-Type: {{contentType}}

### ---------------------------------------------------------------------------
### 6. Get country by ISO code – not found
# GET /api/store/locations/countries/by-iso/{isoCode}
# Expected: 404 Not Found
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/store/locations/countries/by-iso/ZZ
Content-Type: {{contentType}}
