# =============================================================================
# ReSys.Shop API Test - Admin Catalog Taxonomies
# =============================================================================
# @baseUrl          = {{baseUrl}}
# @contentType      = {{contentType}}
# @adminToken       = {{adminToken}}
# @nonExistentId    = {{nonExistentId}}
# @existingTaxonomyId = {{existingTaxonomyId}}
# =============================================================================

### ---------------------------------------------------------------------------
### 1. Create taxonomy – success
# POST /api/admin/catalog/taxonomies
# Expected: 201 Created with location header
# ---------------------------------------------------------------------------
POST {{baseUrl}}/api/admin/catalog/taxonomies
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "name": "Categories",
  "description": "Product categories taxonomy"
}

### ---------------------------------------------------------------------------
### 2. Create taxonomy – duplicate
# POST /api/admin/catalog/taxonomies
# Expected: 409 Conflict – name already exists
# ---------------------------------------------------------------------------
POST {{baseUrl}}/api/admin/catalog/taxonomies
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "name": "Categories",
  "description": "Duplicate taxonomy"
}

### ---------------------------------------------------------------------------
### 3. List taxonomies (paged)
# GET /api/admin/catalog/taxonomies
# Expected: 200 OK – paged list of taxonomies
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/admin/catalog/taxonomies?page={{page}}&pageSize={{pageSize}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------------
### 4. Get taxonomy by ID – success
# GET /api/admin/catalog/taxonomies/{id}
# Expected: 200 OK – single taxonomy
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/admin/catalog/taxonomies/{{existingTaxonomyId}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------------
### 5. Get taxonomy by ID – not found
# GET /api/admin/catalog/taxonomies/{id}
# Expected: 404 Not Found
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/admin/catalog/taxonomies/{{nonExistentId}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------------
### 6. Update taxonomy – success
# PUT /api/admin/catalog/taxonomies/{id}
# Expected: 200 OK – updated taxonomy
# ---------------------------------------------------------------------------
PUT {{baseUrl}}/api/admin/catalog/taxonomies/{{existingTaxonomyId}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "name": "Categories",
  "description": "Updated product categories taxonomy"
}

### ---------------------------------------------------------------------------
### 7. Soft delete taxonomy – success
# DELETE /api/admin/catalog/taxonomies/{id}
# Expected: 200 OK – taxonomy soft-deleted
# ---------------------------------------------------------------------------
DELETE {{baseUrl}}/api/admin/catalog/taxonomies/{{existingTaxonomyId}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------------
### 8. Restore taxonomy – success
# PATCH /api/admin/catalog/taxonomies/{id}/restore
# Expected: 200 OK – taxonomy restored
# ---------------------------------------------------------------------------
PATCH {{baseUrl}}/api/admin/catalog/taxonomies/{{existingTaxonomyId}}/restore
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}
