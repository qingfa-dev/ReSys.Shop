# =============================================================================
# ReSys.Shop API Test - Admin Catalog Product Classifications
# =============================================================================
# @baseUrl          = {{baseUrl}}
# @contentType      = {{contentType}}
# @adminToken       = {{adminToken}}
# @existingProductId = {{existingProductId}}
# @existingTaxonId  = {{existingTaxonId}}
# =============================================================================

### ---------------------------------------------------------------------------
### 1. Get classifications
# GET /api/catalog/product-classifications?productId=
# Expected: 200 OK – list of product classifications
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/catalog/product-classifications?productId={{existingProductId}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------------
### 2. Assign taxons – success
# POST /api/catalog/product-classifications/assign (ProductId in body)
# Expected: 200 OK – taxons assigned to product
# ---------------------------------------------------------------------------
POST {{baseUrl}}/api/catalog/product-classifications/assign
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "productId": "{{existingProductId}}",
  "taxonIds": ["{{existingTaxonId}}"]
}

### ---------------------------------------------------------------------------
### 3. Revoke taxons – success
# POST /api/catalog/product-classifications/revoke (ProductId in body)
# Expected: 200 OK – taxons revoked from product
# ---------------------------------------------------------------------------
POST {{baseUrl}}/api/catalog/product-classifications/revoke
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "productId": "{{existingProductId}}",
  "taxonIds": ["{{existingTaxonId}}"]
}

### ---------------------------------------------------------------------------
### 4. Sync classifications – success
# PUT /api/catalog/product-classifications/sync (ProductId in body)
# Expected: 200 OK – classifications synchronized
# ---------------------------------------------------------------------------
PUT {{baseUrl}}/api/catalog/product-classifications/sync
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "productId": "{{existingProductId}}",
  "taxonIds": ["{{existingTaxonId}}"]
}
