# =============================================================================
# ReSys.Shop API Test - Admin Catalog Taxon Rules
# =============================================================================
# @baseUrl          = {{baseUrl}}
# @contentType      = {{contentType}}
# @adminToken       = {{adminToken}}
# @nonExistentId    = {{nonExistentId}}
# @existingTaxonomyId = {{existingTaxonomyId}}
# @existingTaxonId  = {{existingTaxonId}}
# =============================================================================

### ---------------------------------------------------------------------------
### 1. Create rule – success
# POST /api/admin/catalog/taxon-rules (TaxonId in body)
# Expected: 201 Created with location header
# ---------------------------------------------------------------------------
POST {{baseUrl}}/api/admin/catalog/taxon-rules
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "taxonId": "{{existingTaxonId}}",
  "type": "PriceRange",
  "value": "10-100",
  "operator": "Between"
}

### ---------------------------------------------------------------------------
### 2. List rules
# GET /api/admin/catalog/taxon-rules?taxonId=
# Expected: 200 OK – list of taxon rules
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/admin/catalog/taxon-rules?taxonId={{existingTaxonId}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------------
### 3. Update rule – success
# PUT /api/admin/catalog/taxon-rules/{ruleId} (TaxonId in body)
# Expected: 200 OK – updated rule
# ---------------------------------------------------------------------------
PUT {{baseUrl}}/api/admin/catalog/taxon-rules/{{nonExistentId}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "taxonId": "{{existingTaxonId}}",
  "type": "PriceRange",
  "value": "20-200",
  "operator": "Between"
}

### ---------------------------------------------------------------------------
### 4. Delete rule – success
# DELETE /api/admin/catalog/taxon-rules/{ruleId} (TaxonId in body)
# Expected: 200 OK – rule removed
# ---------------------------------------------------------------------------
DELETE {{baseUrl}}/api/admin/catalog/taxon-rules/{{nonExistentId}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "taxonId": "{{existingTaxonId}}"
}

### ---------------------------------------------------------------------------
### 5. Sync rules
# POST /api/admin/catalog/taxon-rules/sync (TaxonId in body)
# Expected: 200 OK – rules replaced with provided array
# ---------------------------------------------------------------------------
POST {{baseUrl}}/api/admin/catalog/taxon-rules/sync
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "taxonId": "{{existingTaxonId}}",
  "rules": [
    {
      "type": "Brand",
      "value": "Nike",
      "operator": "Equals"
    },
    {
      "type": "PriceRange",
      "value": "0-500",
      "operator": "Between"
    }
  ]
}
