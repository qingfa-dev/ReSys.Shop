# =============================================================================
# ReSys.Shop API Test - Admin Catalog Products
# =============================================================================
# @baseUrl          = {{baseUrl}}
# @contentType      = {{contentType}}
# @adminToken       = {{adminToken}}
# @nonExistentId    = {{nonExistentId}}
# @existingProductId = {{existingProductId}}
# =============================================================================

### ---------------------------------------------------------------------------
### 1. Create product – success
# POST /api/admin/catalog/products
# Expected: 201 Created with location header
# ---------------------------------------------------------------------------
POST {{baseUrl}}/api/admin/catalog/products
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "name": "Classic T-Shirt",
  "slug": "classic-t-shirt",
  "description": "A classic cotton t-shirt for everyday wear",
  "masterVariant": {
    "sku": "TSH-001",
    "price": 29.99,
    "currency": "USD"
  }
}

### ---------------------------------------------------------------------------
### 2. Create product – duplicate slug
# POST /api/admin/catalog/products
# Expected: 409 Conflict – slug already exists
# ---------------------------------------------------------------------------
POST {{baseUrl}}/api/admin/catalog/products
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "name": "Classic T-Shirt Duplicate",
  "slug": "classic-t-shirt",
  "description": "Duplicate slug product",
  "masterVariant": {
    "sku": "TSH-002",
    "price": 24.99,
    "currency": "USD"
  }
}

### ---------------------------------------------------------------------------
### 3. Create product – validation error (missing name)
# POST /api/admin/catalog/products
# Expected: 400 Bad Request – name is required
# ---------------------------------------------------------------------------
POST {{baseUrl}}/api/admin/catalog/products
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "name": "",
  "slug": "invalid-product",
  "description": "Missing name",
  "masterVariant": {
    "sku": "TSH-003",
    "price": 19.99,
    "currency": "USD"
  }
}

### ---------------------------------------------------------------------------
### 4. List products (paged)
# GET /api/admin/catalog/products
# Expected: 200 OK – paged list of products
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/admin/catalog/products?page={{page}}&pageSize={{pageSize}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------------
### 5. Get product by ID – success
# GET /api/admin/catalog/products/{id}
# Expected: 200 OK – single product
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/admin/catalog/products/{{existingProductId}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------------
### 6. Get product by ID – not found
# GET /api/admin/catalog/products/{id}
# Expected: 404 Not Found
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/admin/catalog/products/{{nonExistentId}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------------
### 7. Update product – success
# PUT /api/admin/catalog/products/{id}
# Expected: 200 OK – updated product
# ---------------------------------------------------------------------------
PUT {{baseUrl}}/api/admin/catalog/products/{{existingProductId}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "name": "Classic T-Shirt Premium",
  "slug": "classic-t-shirt-premium",
  "description": "Updated description for premium version"
}

### ---------------------------------------------------------------------------
### 8. Activate product – success
# PATCH /api/admin/catalog/products/{id}/activate
# Expected: 200 OK – product activated
# ---------------------------------------------------------------------------
PATCH {{baseUrl}}/api/admin/catalog/products/{{existingProductId}}/activate
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------------
### 9. Discontinue product – success
# PATCH /api/admin/catalog/products/{id}/discontinue
# Expected: 200 OK – product discontinued
# ---------------------------------------------------------------------------
PATCH {{baseUrl}}/api/admin/catalog/products/{{existingProductId}}/discontinue
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------------
### 10. Soft delete product – success
# DELETE /api/admin/catalog/products/{id}
# Expected: 200 OK – product deleted
# ---------------------------------------------------------------------------
DELETE {{baseUrl}}/api/admin/catalog/products/{{existingProductId}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------------
### 11. No authentication – 401
# GET /api/admin/catalog/products
# Expected: 401 Unauthorized – missing or invalid token
# ---------------------------------------------------------------------------
GET {{baseUrl}}/api/admin/catalog/products
Content-Type: {{contentType}}
