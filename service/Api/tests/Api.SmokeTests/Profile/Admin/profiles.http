# =============================================================================
# Profile - Admin Profiles API Tests
# =============================================================================
# Base URL: {{baseUrl}}/api/profiles/profiles
# Auth: Admin Bearer Token required for most operations
# =============================================================================

### List all profiles (200)
# Returns paged list of all profiles
# Expected: 200 OK with paginated profile list
GET {{baseUrl}}/api/profiles/profiles
Authorization: Bearer {{adminToken}}

### List profiles with pagination (200)
# Returns profiles for the specified page
# Expected: 200 OK with paginated results for the given page
GET {{baseUrl}}/api/profiles/profiles?page={{page}}&pageSize={{pageSize}}
Authorization: Bearer {{adminToken}}

### Get profile by ID - Success (200)
# Returns a single profile by its GUID
# Expected: 200 OK with profile details
GET {{baseUrl}}/api/profiles/profiles/{{existingProfileId}}
Authorization: Bearer {{adminToken}}

### Get profile by ID - Not Found (404)
# Attempts to retrieve a profile with a non-existent ID
# Expected: 404 Not Found
GET {{baseUrl}}/api/profiles/profiles/{{nonExistentId}}
Authorization: Bearer {{adminToken}}

### List all profiles - No Auth (401)
# Attempts to list profiles without an Authorization header
# Expected: 401 Unauthorized
GET {{baseUrl}}/api/profiles/profiles
