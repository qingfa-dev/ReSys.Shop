# =============================================================================
# ReSys.Shop API Test - Store Identity / Emails
# =============================================================================
# Email change, confirmation, and verification resend.
# =============================================================================

### Change Email - Success (200)
# Initiates an email change request. A verification link is sent to the new address.
# Expect: 200 OK with confirmation message.
POST {{baseUrl}}/api/storefront/identity/emails/change
Content-Type: {{contentType}}
Authorization: Bearer {{storeToken}}

{
  "newEmail": "alice.new@example.com",
  "password": "Customer123!"
}

### Change Email - Wrong Password (400)
# Current password does not match.
# Expect: 400 Bad Request with invalid password error.
POST {{baseUrl}}/api/storefront/identity/emails/change
Content-Type: {{contentType}}
Authorization: Bearer {{storeToken}}

{
  "newEmail": "alice.other@example.com",
  "password": "WrongPassword99!"
}

### Confirm Email - Success (200)
# Confirms email ownership using userId and verification token.
# Expect: 200 OK with email confirmed message.
POST {{baseUrl}}/api/storefront/identity/emails/confirm
Content-Type: {{contentType}}

{
  "userId": "{{existingUserId}}",
  "token": "cfm_eyJhbGciOiJIUzI1NiJ9.placeholder"
}

### Resend Verification - Success (200)
# Resends the email verification link.
# Expect: 200 OK with confirmation that the email was resent.
POST {{baseUrl}}/api/storefront/identity/emails/resend
Content-Type: {{contentType}}
Authorization: Bearer {{storeToken}}

{
  "email": "alice.johnson@example.com"
}
