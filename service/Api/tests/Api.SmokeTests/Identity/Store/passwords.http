# =============================================================================
# ReSys.Shop API Test - Store Identity / Passwords
# =============================================================================
# Password change, forgot, and reset flows.
# =============================================================================

### Change Password - Success (200)
# Changes the current user's password.
# Expect: 200 OK with password changed confirmation.
POST {{baseUrl}}/api/store/identity/passwords/change
Content-Type: {{contentType}}
Authorization: Bearer {{storeToken}}

{
  "currentPassword": "Customer123!",
  "newPassword": "NewSecurePass456!"
}

### Change Password - Wrong Current (400)
# Current password does not match.
# Expect: 400 Bad Request with invalid current password error.
POST {{baseUrl}}/api/store/identity/passwords/change
Content-Type: {{contentType}}
Authorization: Bearer {{storeToken}}

{
  "currentPassword": "WrongPassword99!",
  "newPassword": "AnotherNewPass789!"
}

### Forgot Password - Success (200)
# Sends a password reset link to the user's email.
# Expect: 200 OK with confirmation that reset email was sent.
POST {{baseUrl}}/api/store/identity/passwords/forgot
Content-Type: {{contentType}}

{
  "email": "customer@resys.shop"
}

### Reset Password - Success (200)
# Resets the password using a valid reset token.
# Expect: 200 OK with password reset confirmation.
POST {{baseUrl}}/api/store/identity/passwords/reset
Content-Type: {{contentType}}

{
  "userId": "{{existingUserId}}",
  "token": "pwd_rst_eyJhbGciOiJIUzI1NiJ9.placeholder",
  "newPassword": "ResetPassword123!"
}

### Reset Password - Invalid Token (400)
# Attempt to reset password with an invalid or expired token.
# Expect: 400 Bad Request with invalid token error.
POST {{baseUrl}}/api/store/identity/passwords/reset
Content-Type: {{contentType}}

{
  "userId": "{{existingUserId}}",
  "token": "invalid-or-expired-token",
  "newPassword": "NewPassword789!"
}
