# Development environment template for the API (do NOT store secrets in git for production)
# Copy to `.env` or use Aspire user secrets / environment variables in CI/CD.

# Database
ConnectionStrings__DefaultConnection=Host=localhost;Database=resys_shop;Username=postgres;Password=REPLACE_ME_WITH_DB_PASSWORD

# Authentication
Authentication__Jwt__Secret=REPLACE_ME_WITH_LONG_RANDOM_SECRET
Authentication__Google__ClientId=

# CORS (comma-separated list)
Cors__Origins=http://localhost:5173,http://localhost:4173,http://localhost:3000
Cors__AllowCredentials=true

# Storage
Storage__Providers__Local__LocalPath=./uploads

# Notifications (Email)
Notification__Channels__Email__FromEmail=noreply@resys.shop
Notification__Channels__Email__FromName=ReSys Shop
Notification__Channels__Email__Providers__Smtp__Host=localhost
Notification__Channels__Email__Providers__Smtp__Port=1025
Notification__Channels__Email__Providers__Smtp__EnableSsl=false
Notification__Channels__Email__Providers__Smtp__UseDefaultCredentials=true

# Background jobs
BackgroundJobs__CachingEnabled=false

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=

# Frontend (Vite) — set in each SPA's env file; Aspire will override when orchestrating
VITE_API_URL=http://localhost:5035
