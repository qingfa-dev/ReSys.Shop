{
  "_dev_secrets_setup_comment": "Authentication:Jwt:Secret, GatewayProviders:SettingsEncryptionKey, and ConnectionStrings:DefaultConnection are loaded from dotnet user-secrets (id: resys.shop.api). Run: ./service/Api/scripts/setup-dev-secrets.sh. Production deploys MUST set Authentication__Jwt__Secret and GatewayProviders__SettingsEncryptionKey as environment variables.",
  "DatabaseInitialization": {
    "RunMigrations": true,
    "DropSchemas": true
  },
  "GatewayProviders": {
    "bogus": {
      "Enabled": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "_dev_db_comment": "ConnectionStrings:DefaultConnection is loaded from dotnet user-secrets. Run: ./service/Api/scripts/setup-dev-secrets.sh",
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "http://localhost:4173",
      "http://localhost:3000"
    ],
    "AllowCredentials": true
  },
  "Storage": {
    "Providers": {
      "Local": {
        "LocalPath": "../../../infra/Storage/demo"
      }
    },
    "MalwareScanner": {
      "Enabled": false,
      "DisableInDevelopment": true
    }
  },
  "Notification": {
    "SupportPhone": "+15551234567",
    "ApplicationUrl": "http://localhost:5000",
    "CustomerSupportLink": "http://localhost:5000/support",
    "UnsubscribeUrl": "http://localhost:5000/unsubscribe",
    "SurveyUrl": "http://localhost:5000/survey",
    "Channels": {
      "Email": {
        "Providers": {
          "Smtp": {
            "Host": "localhost",
            "Port": 1025
          }
        }
      }
    }
  },
  "Seeders": {
    "DemoDataPath": "../../../../benchmarks/scripts/demo-seed/output"
  }
}
