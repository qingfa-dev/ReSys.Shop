{
  "Payment": {
    "UseBogusGateway": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=resys_shop;Username=postgres;Password=postgres"
  },
  "Authentication": {
    "Jwt": {
      "Secret": "ThisIsADevelopmentJwtSecretKeyThatIsLongEnough32!"
    },
    "Google": {
      "ClientId": ""
    }
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "http://localhost:4173",
      "http://localhost:3000"
    ],
    "AllowCredentials": true
  },
  "Storage": {
    "Providers": {
      "Local": {
        "LocalPath": "./uploads"
      }
    },
    "MalwareScanner": {
      "Enabled": false,
      "DisableInDevelopment": true
    }
  },
  "Notification": {
    "Channels": {
      "Email": {
        "FromEmail": "noreply@resys.shop",
        "FromName": "ReSys Shop",
        "Providers": {
          "Smtp": {
            "Host": "localhost",
            "Port": 1025,
            "EnableSsl": false,
            "UseDefaultCredentials": true
          }
        }
      }
    }
  },
  "BackgroundJobs": {
    "CachingEnabled": false
  }
}
