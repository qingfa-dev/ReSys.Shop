  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Shared/Shared.Foundations/Shared.Foundations.csproj" />
    <ProjectReference Include="../Shared/Shared.Governance/Shared.Governance.csproj" />
    <ProjectReference Include="../Shared/Shared.Platform/Shared.Platform.csproj" />
