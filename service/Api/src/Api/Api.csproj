    <ProjectReference Include="../Shared/Shared.Persistence/Shared.Persistence.csproj" />
    <ProjectReference Include="../Shared/Shared.Integration/Shared.Integration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Module/Module.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Migrations/Api.Migrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>


</Project>