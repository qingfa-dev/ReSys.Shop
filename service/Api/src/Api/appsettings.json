{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Authentication": {
    "Jwt": {
      "Secret": "",
      "Issuer": "ReSys.Shop",
      "Audience": "ReSys.Shop",
      "AccessTokenExpirationInMinutes": 15,
      "RefreshTokenExpirationInDays": 7,
      "Algorithm": "HS256",
      "TokenSecurity": {
        "RotationEnabled": false,
        "ReuseDetectionEnabled": false,
        "SlidingExpirationEnabled": false,
        "MaxTokenAgeDays": 30
      }
    },
    "Google": {
      "ClientId": ""
    }
  },
  "Authorization": {
    "PermissionCache": {
      "SlidingExpiration": "00:05:00",
      "AbsoluteExpiration": "00:30:00"
    }
  },
  "Cors": {
    "Origins": [],
    "AllowCredentials": false
  },
  "AntiForgery": {
    "IsEnabled": true,
    "HeaderName": "X-CSRF-TOKEN",
    "Required": true,
    "CookieName": ".AspNetCore.Antiforgery",
    "CookieSameSite": "Strict",
    "CookieSecurePolicy": "Always",
    "CookieHttpOnly": true,
    "CookieMaxAgeMinutes": null
  },
  "GuestSession": {
    "CookieName": "Guest",
    "CookieSameSite": "Lax",
    "CookieSecurePolicy": "Always",
    "CookieHttpOnly": true,
    "ExpirationInDays": 30
  },
  "Observability": {
    "ServiceName": "ReSys.Api",
    "ServiceVersion": "1.0.0",
    "UseAspireOTLPExporter": true,
    "CorrelationHeader": "X-Correlation-Id",
    "MinimumLogLevel": "Information",
    "SensitiveHeaders": ["Authorization", "Cookie", "X-Api-Key"],
    "ExposeDetailedReport": false
  },
  "Caching": {
    "Enabled": true,
    "Memory": {
      "Enabled": true,
      "DefaultExpirationMinutes": 5,
      "CompactionPercentage": 5
    },
    "Distributed": {
      "Enabled": true,
      "Type": "redis",
      "DefaultExpirationMinutes": 60
    },
    "Hybrid": {
      "Enabled": true,
      "DefaultExpirationMinutes": 5,
      "MaximumPayloadBytes": 1048576,
      "MaximumKeyLength": 512
    }
  },
  "Http": {
    "DefaultTimeoutSeconds": 30,
    "AttachResiliencePipelineByDefault": true,
    "PropagateCorrelationId": true,
    "Clients": {}
  },
  "Storage": {
    "DefaultProvider": "Local",
    "BaseUrl": "",
    "Enabled": true,
    "Security": {
      "MaxFileSizeBytes": 10485760,
      "AllowedExtensions": [
        ".jpg", ".jpeg", ".png", ".gif", ".webp", ".svg",
        ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".csv", ".txt", ".zip"
      ],
      "BlockedExtensions": [
        ".exe", ".bat", ".cmd", ".com", ".msi", ".scr",
        ".ps1", ".vbs", ".jar", ".war", ".iso"
      ],
      "ValidateMagicBytes": true,
      "EncryptionKey": ""
    },
    "AntiForgery": {
      "MaxConsecutiveFailures": 5,
      "BlockDuration": "00:15:00"
    },
    "MalwareScanner": {
      "Enabled": false,
      "ClamAvHost": "localhost",
      "ClamAvPort": 3310,
      "DisableInDevelopment": true
    },
    "Providers": {
      "Local": {
        "IsEnabled": true,
        "LocalPath": "./uploads",
        "BufferSize": 4096
      },
      "Azure": {
        "IsEnabled": false,
        "ConnectionString": "",
        "ContainerName": "",
        "BufferSize": 4096
      },
      "S3": {
        "IsEnabled": false,
        "ServiceUrl": "",
        "AccessKey": "",
        "SecretKey": "",
        "BucketName": "",
        "Region": "",
        "ForcePathStyle": false,
        "BufferSize": 4096
      }
    }
  },
  "BackgroundJobs": {
    "Enabled": true,
    "DashboardPath": "/jobs",
    "CachingEnabled": false
  },
  "Notification": {
    "EnableBackgroundJobs": false,
    "ApplicationName": "ReSys Shop",
    "SupportEmail": "support@resys.shop",
    "SupportPhone": "",
    "CustomerSupportLink": "",
    "ApplicationUrl": "",
    "UnsubscribeUrl": "",
    "SurveyUrl": "",
    "Channels": {
      "Email": {
        "Enabled": true,
        "FromEmail": "",
        "FromName": "",
        "Providers": {
          "SendGrids": {
            "Enabled": false,
            "Priority": 2,
            "RetryCount": 3,
            "Timeout": "00:00:30",
            "ApiKey": ""
          },
          "Smtp": {
            "Enabled": true,
            "Priority": 1,
            "RetryCount": 3,
            "Timeout": "00:00:30",
            "Host": "localhost",
            "Port": 25,
            "EnableSsl": false,
            "UseDefaultCredentials": true
          }
        }
      },
      "Sms": {
        "Enabled": false,
        "DefaultSenderNumber": "",
        "Providers": {
          "Sinch": {
            "Enabled": false,
            "Priority": 1,
            "RetryCount": 3,
            "Timeout": "00:00:30",
            "ProjectId": "",
            "KeyId": "",
            "KeySecret": "",
            "SenderPhoneNumber": ""
          }
        }
      }
    }
  }
}
