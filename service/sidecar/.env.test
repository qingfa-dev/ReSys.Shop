# =============================================================================
# .env.test — Test Environment Settings
# =============================================================================

# Service Identity
PROJECT_NAME=inference
PORT=5002
ENVIRONMENT=test

# Security
# Shared test key (>= 16 chars) matching conftest.py
API_KEY=test-key-for-sidecar-integration-tests

# Machine Learning
ONNX_MODEL_DIR=models
HUGGING_FACE_TOKEN=hf_dummy_token_for_tests

# Build/Package Optimization
UV_LINK_MODE=copy

# Observability
# Disable OTLP during CI/local tests to prevent timeouts
LOG_LEVEL=DEBUG
OTEL_EXPORTER_OTLP_ENDPOINT=

# Performance Throttling for Tests
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
