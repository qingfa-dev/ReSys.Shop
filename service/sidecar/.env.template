# =============================================================================
# .env.template — Template for Inference Service Environment Variables
# =============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env for local development.
# 2. Update values to match your local setup or CI requirements.
# 3. Use ENVIRONMENT to determine which .env.{env} file to load.
#    (e.g., ENVIRONMENT=test will load .env.test if it exists).
#
# =============================================================================

# ── Service Identity & Network ───────────────────────────────────────────────
# The human-readable name of the service, used in logs and traces.
PROJECT_NAME=inference
# The local network port the FastAPI server binds to.
PORT=5002
# The local network port for HTTPS (used if certificates are provided).
HTTPS_PORT=5003

# ── Security ──────────────────────────────────────────────────────────────────
# A shared secret for authenticating internal sidecar calls. 
# It MUST match the value expected by the Gateway or calling service.
# MINIMUM 16 characters for security.
API_KEY=dev-key-must-be-long-enough
# Global default rate limit for embedding endpoints (e.g., "100/minute").
RATE_LIMIT=100/minute

# ── SSL Certificate Configuration ─────────────────────────────────────────────
# Optional paths for secure communication.
SSL_CERT_FILE=
SSL_CERT_DIR=

# ── Machine Learning Configuration ────────────────────────────────────────────
# The directory where ONNX model artifacts are stored.
# In local dev: use a relative path like "models" to sidecar root.
# In Docker: use a mounted path like "/app/models".
ONNX_MODEL_DIR=models

# (Optional) Hugging Face Hub token to access gated models (like Fashion-CLIP).
# Generate at: https://huggingface.co/settings/tokens
HUGGING_FACE_TOKEN=

# ── Observability (managed by Aspire/OTEL) ───────────────────────────────────
# The level of detail for console and telemetry logging (DEBUG, INFO, WARNING, ERROR, CRITICAL).
LOG_LEVEL=INFO
# The OTLP gRPC endpoint for distributed tracing, metrics, and logs.
# For local development with Aspire, use http://localhost:4317.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── Environment ──────────────────────────────────────────────────────────────
# Identifies the current runtime environment (dev, test, production).
# Controls which .env file is loaded and affects telemetry sampling.
ENVIRONMENT=dev

# ── Runtime Performance ───────────────────────────────────────────────────────
# Control thread counts for numerical libraries to avoid CPU oversubscription.
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
NUMEXPR_NUM_THREADS=4
