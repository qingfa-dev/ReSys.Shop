@startuml 10-deployment

skinparam backgroundColor White
skinparam DefaultFontSize 11

title Deployment Diagram — ReSys.Shop (Conceptual Production)

rectangle "Aspire Orchestration Boundary" as aspire #F0F8FF {
    node "Vue Store SPA\n(Static Hosting / CDN)" as store_spa
    node "Vue Admin SPA\n(Static Hosting / CDN)" as admin_spa
}

node "Docker Host" as docker {
    frame "Application Tier" {
        node "API Container 1\n.NET 10 Modular Monolith" as api1
        node "API Container 2\n.NET 10 Modular Monolith" as api2
        node "Embedding Container\nPython 3.12 + FastAPI + PyTorch" as emb
    }

    frame "Data Tier" {
        database "PostgreSQL 17\nPrimary + Replica\npgvector extension" as pg
        database "Redis 7 Cluster\nCache + Hangfire Jobs" as redis
    }
}

cloud "External Services" {
    node "Stripe API\nPayments + Webhooks" as stripe
    node "SendGrid / SMTP\nEmail" as sendgrid
    node "S3-Compatible Storage\nProduct Images" as s3
    node "Google OAuth\nExternal Login" as google
}

actor "Browser\nCustomer / Admin" as browser

browser --> store_spa : HTTPS
browser --> admin_spa : HTTPS
browser --> api1 : HTTPS /api
browser --> api2 : HTTPS /api

api1 --> pg : TCP 5432
api2 --> pg : TCP 5432
api1 --> redis : TCP 6379
api2 --> redis : TCP 6379
api1 --> emb : HTTP 8000
api2 --> emb : HTTP 8000

api1 --> stripe : HTTPS
api2 --> stripe : HTTPS
api1 --> sendgrid : HTTPS / SMTP
api2 --> sendgrid : HTTPS / SMTP
api1 --> s3 : HTTPS
api2 --> s3 : HTTPS
api1 --> google : HTTPS OAuth
api2 --> google : HTTPS OAuth

@enduml
